# metamodel_version: 1.12.0
# version: 1.0.0
BASE <https://w3id.org/lmodel/nist-ai-600-1/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX nist_ai_100_1: <https://w3id.org/lmodel/nist-ai-100-1/>
PREFIX schema1: <http://schema.org/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

nist_ai_100_1:AiRmfFunctionIdentifier xsd:string

nist_ai_100_1:AiRmfCategoryIdentifier xsd:string

nist_ai_100_1:AiRmfSubcategoryIdentifier xsd:string

<GaiActionIdentifier> xsd:string

nist_ai_100_1:AiRmfProfile  (
    CLOSED {
       (  $nist_ai_100_1:AiRmfProfile_tes (  &nist_ai_100_1:AiRmfRecord_tes ;
             rdf:type [ nist_ai_100_1:Record ] ? ;
             nist_ai_100_1:ai_rmf_profile_kinds [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#use_case>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#current>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#target>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#cross_sectoral> ] + ;
             nist_ai_100_1:ai_rmf_profile_setting @linkml:String ? ;
             nist_ai_100_1:ai_rmf_profile_subcategories @nist_ai_100_1:AiRmfSubcategoryIdentifier *
          ) ;
          rdf:type [ nist_ai_100_1:Profile ]
       )
    } OR @<GaiProfile>
)

nist_ai_100_1:AiRmfRecord  (
    {
       (  $nist_ai_100_1:AiRmfRecord_tes (  schema1:name @linkml:String ? ;
             schema1:description @linkml:String ?
          ) ;
          rdf:type [ nist_ai_100_1:Record ]
       )
    } OR @nist_ai_100_1:AiRmfProfile
)

<GaiAiRedTeaming> CLOSED {
    (  $<GaiAiRedTeaming_tes> (  &<GaiStructuredFeedback_tes> ;
          rdf:type [ <StructuredFeedback> ] ? ;
          <gai_red_teaming_types> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRedTeamingType#general_public>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRedTeamingType#expert>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRedTeamingType#combination>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRedTeamingType#human_ai> ] *
       ) ;
       rdf:type [ <AiRedTeaming> ] ?
    )
}

<GaiContentProvenanceConsideration> CLOSED {
    (  $<GaiContentProvenanceConsideration_tes> (  &<GaiPrimaryConsideration_tes> ;
          rdf:type [ <PrimaryConsideration> ] ? ;
          <gai_provenance_techniques> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiProvenanceTechnique#digital_watermarking>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiProvenanceTechnique#metadata_recording>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiProvenanceTechnique#digital_fingerprinting>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiProvenanceTechnique#human_authentication> ] *
       ) ;
       rdf:type [ <ContentProvenanceConsideration> ] ?
    )
}

<GaiFieldTesting> CLOSED {
    (  $<GaiFieldTesting_tes> (  &<GaiStructuredFeedback_tes> ;
          rdf:type [ <StructuredFeedback> ] ?
       ) ;
       rdf:type [ <FieldTesting> ] ?
    )
}

<GaiGovernanceConsideration> CLOSED {
    (  $<GaiGovernanceConsideration_tes> (  &<GaiPrimaryConsideration_tes> ;
          rdf:type [ <PrimaryConsideration> ] ? ;
          <gai_governance_plans> [
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#accessibility_and_reasonable_accommodations>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#ai_actor_credentials_and_qualifications>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#alignment_to_organizational_values>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#auditing_and_assessment>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#change_management_controls>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#commercial_use>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#data_provenance>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#data_protection>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#data_retention>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#consistency_in_use_of_defining_key_terms>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#decommissioning>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#discouraging_anonymous_use>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#education>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#impact_assessments>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#incident_response>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#monitoring>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#opt_outs>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#risk_based_controls>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#risk_mapping_and_measurement>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#science_backed_tevv_practices>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#secure_software_development_practices>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#stakeholder_engagement>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#synthetic_content_detection_and_labeling_tools_and_techniques>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#whistleblower_protections>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiGovernancePlan#workforce_diversity_and_interdisciplinary_teams> ] * ;
          <gai_third_party_controls> [
             <https://w3id.org/lmodel/nist-ai-600-1/GaiThirdPartyControl#acquisition_and_procurement_due_diligence>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiThirdPartyControl#software_bills_of_materials>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiThirdPartyControl#service_level_agreements>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiThirdPartyControl#ssae_reports> ] *
       ) ;
       rdf:type [ <GovernanceConsideration> ] ?
    )
}

<GaiIncidentDisclosureConsideration> CLOSED {
    (  $<GaiIncidentDisclosureConsideration_tes> (  &<GaiPrimaryConsideration_tes> ;
          rdf:type [ <PrimaryConsideration> ] ? ;
          <gai_incident_harms> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiIncidentHarm#injury_or_harm_to_health>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiIncidentHarm#critical_infrastructure_disruption>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiIncidentHarm#rights_violations>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiIncidentHarm#harm_to_property_communities_or_environment> ] *
       ) ;
       rdf:type [ <IncidentDisclosureConsideration> ] ?
    )
}

<GaiParticipatoryEngagement> CLOSED {
    (  $<GaiParticipatoryEngagement_tes> (  &<GaiStructuredFeedback_tes> ;
          rdf:type [ <StructuredFeedback> ] ?
       ) ;
       rdf:type [ <ParticipatoryEngagement> ] ?
    )
}

<GaiPreDeploymentTestingConsideration> CLOSED {
    (  $<GaiPreDeploymentTestingConsideration_tes> (  &<GaiPrimaryConsideration_tes> ;
          rdf:type [ <PrimaryConsideration> ] ? ;
          <gai_structured_feedback> @<GaiStructuredFeedback> *
       ) ;
       rdf:type [ <PreDeploymentTestingConsideration> ] ?
    )
}

<GaiPrimaryConsideration>  (
    @<GaiContentProvenanceConsideration> OR @<GaiGovernanceConsideration> OR @<GaiIncidentDisclosureConsideration> OR
    @<GaiPreDeploymentTestingConsideration>
)

<GaiPrimaryConsideration_struct> {
    (  $<GaiPrimaryConsideration_tes> (  <gai_consideration_type> @linkml:String ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ? ;
          <gai_consideration_sections> @linkml:String *
       ) ;
       rdf:type [ <PrimaryConsideration> ] ?
    )
}

<GaiProfile> CLOSED {
    (  $<GaiProfile_tes> (  &nist_ai_100_1:AiRmfProfile_tes ;
          rdf:type [ nist_ai_100_1:Profile ] ? ;
          <gai_risks> @<GaiRisk> + ;
          <gai_subcategories> @<GaiSubcategory> + ;
          <gai_primary_considerations> @<GaiPrimaryConsideration> *
       ) ;
       rdf:type [ <Profile> ]
    )
}

<GaiRisk> CLOSED {
    (  $<GaiRisk_tes> (  schema1:description @linkml:String ? ;
          <gai_risk_name> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#cbrn_information_or_capabilities>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#confabulation>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#dangerous_violent_or_hateful_content>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#data_privacy>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#environmental_impacts>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#harmful_bias_or_homogenization>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#human_ai_configuration>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#information_integrity>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#information_security>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#intellectual_property>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#obscene_degrading_or_abusive_content>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#value_chain_and_component_integration> ] ;
          <gai_risk_section> @linkml:String ;
          <gai_risk_characteristics> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#valid_and_reliable>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#safe>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#secure_and_resilient>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#accountable_and_transparent>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#explainable_and_interpretable>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#privacy_enhanced>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#fair_with_harmful_bias_managed> ] * ;
          <gai_risk_groupings> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskGrouping#technical_or_model>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskGrouping#misuse_by_humans>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskGrouping#ecosystem_or_societal> ] * ;
          <gai_risk_lifecycle_stages> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStage#design>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStage#development>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStage#deployment>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStage#operation>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStage#decommissioning> ] * ;
          <gai_risk_scopes> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScope#model_or_system>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScope#application_or_implementation>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScope#ecosystem> ] * ;
          <gai_risk_sources> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSource#design>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSource#training>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSource#operation>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSource#inputs>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSource#outputs>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSource#human_behavior>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSource#human_ai_interaction> ] * ;
          <gai_risk_time_scales> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScale#abrupt>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScale#extended> ] *
       ) ;
       rdf:type [ <Risk> ] ?
    )
}

<GaiStructuredFeedback>  (
    @<GaiAiRedTeaming> OR @<GaiFieldTesting> OR @<GaiParticipatoryEngagement>
)

<GaiStructuredFeedback_struct> {
    (  $<GaiStructuredFeedback_tes> (  <gai_feedback_type> @linkml:String ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <StructuredFeedback> ] ?
    )
}

<GaiSubcategory> CLOSED {
    (  $<GaiSubcategory_tes> (  nist_ai_100_1:ai_rmf_subcategory_id @nist_ai_100_1:AiRmfSubcategoryIdentifier ;
          schema1:description @linkml:String ;
          <gai_subcategory_actions> @<GaiSuggestedAction> + ;
          <gai_subcategory_actor_tasks> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_development>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_deployment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#operation_and_monitoring>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#tevv>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#human_factors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#domain_expert>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_impact_assessment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#procurement>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#governance_and_oversight>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#third_party_entities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#end_users>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#affected_individuals_and_communities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#other_ai_actors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#general_public> ] *
       ) ;
       rdf:type [ <Subcategory> ] ?
    )
}

<GaiSuggestedAction> CLOSED {
    (  $<GaiSuggestedAction_tes> (  <gai_action_id> @<GaiActionIdentifier> ;
          schema1:description @linkml:String ;
          <gai_action_risks> [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#cbrn_information_or_capabilities>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#confabulation>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#dangerous_violent_or_hateful_content>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#data_privacy>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#environmental_impacts>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#harmful_bias_or_homogenization>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#human_ai_configuration>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#information_integrity>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#information_security>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#intellectual_property>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#obscene_degrading_or_abusive_content>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskName#value_chain_and_component_integration> ] *
       ) ;
       rdf:type [ <SuggestedAction> ] ?
    )
}
