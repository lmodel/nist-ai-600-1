  "default_prefix": "nist_ai_600_1",
  "default_range": "string",
  "subsets": [
    {
      "name": "gai_base",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiBase",
      "description": "GAI-specific base vocabulary defined locally: the divergent\nlifecycle and actor-task enums (`GaiLifecycleStageEnum`,\n`GaiActorTaskEnum`). The shared base scaffolding (`NamedThing`,\nidentifier slots, `SubcategoryCode`, `TrustworthinessCharacteristicEnum`)\nis imported from `nist_ai_rmf_common`; see `*_mappings` for\ncross-references to NIST AI 100-1.",
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "@type": "SubsetDefinition"
    },
    {
      "name": "gai_core",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiCore",
      "description": "Foundational GAI Profile concepts - the 12 risks and their\ndimensions (Section 2).",
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "@type": "SubsetDefinition"
    },
    {
      "name": "gai_actions",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiActions",
      "description": "Suggested Actions organised by AI RMF subcategory (Section 3).",
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "@type": "SubsetDefinition"
    },
    {
      "name": "gai_considerations",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiConsiderations",
      "description": "Primary GAI Considerations (Appendix A): Governance,\nPre-Deployment Testing, Content Provenance, Incident Disclosure.",
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "@type": "SubsetDefinition"
    },
    {
      "name": "gai_feedback",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiFeedback",
      "description": "Structured Public Feedback methods and AI Red-teaming\n(Appendix A.1.5).",
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "@type": "SubsetDefinition"
    },
    {
      "name": "base",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/Base",
      "description": "Schema-infrastructure elements shared across the framework:\nidentifier slots and the abstract `NamedThing` root.",
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common",
      "@type": "SubsetDefinition"
    },
    {
      "name": "trustworthiness",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/Trustworthiness",
      "description": "Characteristics of trustworthy AI systems (NIST AI 100-1 Part 1,\n\u00a73): Valid and Reliable, Safe, Secure and Resilient, Accountable\nand Transparent, Explainable and Interpretable, Privacy-Enhanced,\nand Fair with Harmful Bias Managed.",
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common",
      "@type": "SubsetDefinition"
    }
  ],
  "types": [
    {
      "name": "GaiActionId",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiActionId",
      "description": "Action identifier used in NIST AI 600-1 Section 3, of the form\n\"<prefix>-<category>.<subcategory>-<seq>\" - e.g., \"GV-1.1-001\".\nPrefixes: GV (Govern), MP (Map), MS (Measure), MG (Manage).",
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(GV|MP|MS|MG)-[0-9]+\\.[0-9]+-[0-9]{3}$",
      "@type": "TypeDefinition"
    },
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "integer",
      "definition_uri": "https://w3id.org/linkml/Integer",
      "description": "An integer",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Integer"
      ],
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
