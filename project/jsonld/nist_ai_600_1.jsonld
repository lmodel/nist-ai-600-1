  "classes": [
    {
      "name": "GaiRisk",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiRisk",
      "description": "A risk that is novel to or exacerbated by Generative AI.\nEach instance corresponds to one of the 12 risk categories\nenumerated in NIST AI 600-1 Section 2.",
      "in_subset": [
        "gai_core"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "close_mappings": [
        "nist_ai_100_1:AiSpecificRisk"
      ],
      "related_mappings": [
        "iso29100:PrivacyRisk"
      ],
      "broad_mappings": [
        "iso27001:Risk"
      ],
      "is_a": "NamedThing",
      "slots": [
        "id",
        "name",
        "title",
        "description",
        "see_also",
        "gai_risk_kind",
        "risk_categorization",
        "risk_scope",
        "risk_sources",
        "time_scale",
        "trustworthiness_characteristic",
        "addressed_by_actions",
        "gaiRisk__lifecycle_stage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "lifecycle_stage",
          "description": "AI lifecycle stage(s) at which the GAI risk may arise\n(NIST AI 600-1 Section 2). Uses the GAI five-stage\nlifecycle (`GaiLifecycleStageEnum`).",
          "in_subset": [
            "gai_base"
          ],
          "related_mappings": [
            "nist_ai_100_1:lifecycle_stage"
          ],
          "range": "GaiLifecycleStageEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiRisk",
      "@type": "ClassDefinition"
    },
    {
      "name": "SuggestedAction",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/SuggestedAction",
      "description": "A suggested action an organisation can take to manage GAI\nrisks. Each action is identified by an Action ID, linked to an\nAI RMF subcategory, and may be relevant to one or more GAI\nrisks and AI actor tasks (NIST AI 600-1 Section 3).",
      "in_subset": [
        "gai_actions"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "close_mappings": [
        "stix:CourseOfAction"
      ],
      "related_mappings": [
        "oscal_catalog:Control",
        "gist_linkml:Task"
      ],
      "is_a": "NamedThing",
      "slots": [
        "name",
        "title",
        "see_also",
        "action_id",
        "function_prefix",
        "applies_to_subcategory",
        "gai_risks",
        "suggestedAction__actor_task",
        "SuggestedAction_id",
        "SuggestedAction_description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "actor_task",
          "description": "Pertinent AI Actor Task(s) for the suggested action - i.e.,\nthe \"AI Actor Tasks\" row at the bottom of each Section 3\ntable.",
          "in_subset": [
            "gai_base"
          ],
          "related_mappings": [
            "nist_ai_100_1:actor_task"
          ],
          "range": "GaiActorTaskEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-ai-600-1/SuggestedAction",
      "@type": "ClassDefinition"
    },
    {
      "name": "PrimaryGaiConsideration",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/PrimaryGaiConsideration",
      "description": "An overarching consideration derived from the NIST GAI PWG\nconsultation process (Appendix A). The `consideration_kind`\nattribute discriminates between the four primary\nconsiderations: Governance, Pre-Deployment Testing, Content\nProvenance, and Incident Disclosure.\n\nAll consideration-specific attributes are optional and apply\nto the appropriate `consideration_kind`:\n  * GOVERNANCE: governance_practices, third_party_considerations\n  * PRE_DEPLOYMENT_TESTING: limitations_of_current_approaches\n  * CONTENT_PROVENANCE: provenance_techniques\n  * INCIDENT_DISCLOSURE: ai_incident_definition",
      "in_subset": [
        "gai_considerations"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "related_mappings": [
        "nist_csf:CSFProperty"
      ],
      "is_a": "NamedThing",
      "slots": [
        "id",
        "name",
        "title",
        "description",
        "see_also",
        "consideration_kind",
        "governance_practices",
        "third_party_considerations",
        "limitations_of_current_approaches",
        "provenance_techniques",
        "ai_incident_definition"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/nist-ai-600-1/PrimaryGaiConsideration",
      "@type": "ClassDefinition"
    },
    {
      "name": "StructuredPublicFeedback",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/StructuredPublicFeedback",
      "description": "Methods used to evaluate whether GAI systems are performing as\nintended and to calibrate and verify traditional measurement\nmethods (A.1.5).",
      "in_subset": [
        "gai_feedback"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "related_mappings": [
        "iso27001:InterestedParty"
      ],
      "is_a": "NamedThing",
      "slots": [
        "id",
        "name",
        "title",
        "description",
        "see_also",
        "feedback_method_kind"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/nist-ai-600-1/StructuredPublicFeedback",
      "@type": "ClassDefinition"
    },
    {
