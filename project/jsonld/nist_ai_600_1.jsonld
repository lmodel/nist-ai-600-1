      "@type": "TypeDefinition"
    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "SubcategoryCode",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/SubcategoryCode",
      "description": "Identifier for a Core subcategory (e.g., \"GOVERN 1.1\").",
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(GOVERN|MAP|MEASURE|MANAGE) [0-9]+\\.[0-9]+$",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "GaiLifecycleStageEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum",
      "description": "AI lifecycle stages enumerated in NIST AI 600-1 Section 2:\n\"Risks can arise during design, development, deployment,\noperation, and/or decommissioning.\" Distinct from the six-stage\n`AiLifecycleStageEnum` of NIST AI 100-1 (see `related_mappings`).",
      "in_subset": [
        "gai_base"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "related_mappings": [
        "nist_ai_100_1:AiLifecycleStageEnum"
      ],
      "permissible_values": [
        {
          "text": "DESIGN",
          "description": "Articulating system concept, objectives, requirements."
        },
        {
          "text": "DEVELOPMENT",
          "description": "Building, training, and tuning the GAI model or system."
        },
        {
          "text": "DEPLOYMENT",
          "description": "Placing the GAI system into a production environment."
        },
        {
          "text": "OPERATION",
          "description": "Running and monitoring the GAI system in use."
        },
        {
          "text": "DECOMMISSIONING",
          "description": "Retiring or phasing out the GAI system."
        }
      ]
    },
    {
      "name": "GaiActorTaskEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum",
      "description": "AI Actor Tasks referenced by the Suggested Actions tables in\nNIST AI 600-1 Section 3 (and defined in NIST AI 100-1\nAppendix A).",
      "in_subset": [
        "gai_base"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "related_mappings": [
        "nist_ai_100_1:AiActorTaskEnum"
      ],
      "permissible_values": [
        {
          "text": "GOVERNANCE_AND_OVERSIGHT",
          "description": "Management, fiduciary, and legal authority for the organization."
        },
        {
          "text": "AI_DESIGN",
          "description": "Concept, objectives, planning, design, and data collection."
        },
        {
          "text": "AI_DEVELOPMENT",
          "description": "Model building, selection, calibration, training, and testing."
        },
        {
          "text": "AI_DEPLOYMENT",
          "description": "Contextual decisions on how the AI system is used and deployed."
        },
        {
          "text": "AI_IMPACT_ASSESSMENT",
          "description": "Assessing accountability, bias, impacts, safety, liability, security."
        },
        {
          "text": "OPERATION_AND_MONITORING",
          "description": "Operating the AI system and assessing system output and impacts."
        },
        {
          "text": "TEVV",
          "description": "Test, Evaluation, Verification, and Validation tasks."
        },
        {
          "text": "DOMAIN_EXPERTS",
          "description": "Multidisciplinary practitioners with sector or context expertise."
        },
        {
          "text": "END_USERS",
          "description": "Individuals or groups using the AI system for specific purposes."
        },
        {
          "text": "HUMAN_FACTORS",
          "description": "Human-centered design practices and end-user involvement."
        },
        {
          "text": "AFFECTED_INDIVIDUALS_AND_COMMUNITIES",
          "description": "Individuals, groups, or communities directly or indirectly affected."
        },
        {
          "text": "PROCUREMENT",
          "description": "Acquisition of AI models, products, or services from third parties."
        },
        {
          "text": "THIRD_PARTY_ENTITIES",
          "description": "Providers, developers, vendors, and evaluators external to the deploying organization."
        }
      ]
    },
    {
      "name": "GaiRiskCategoryEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum",
      "description": "The 12 risks unique to or exacerbated by Generative AI as\nenumerated in NIST AI 600-1 Section 2.",
      "in_subset": [
        "gai_core"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "CBRN_INFORMATION_OR_CAPABILITIES",
          "description": "Eased access to or synthesis of materially nefarious\ninformation or design capabilities related to chemical,\nbiological, radiological, or nuclear (CBRN) weapons or\nother dangerous materials or agents."
        },
        {
          "text": "CONFABULATION",
          "description": "The production of confidently stated but erroneous or\nfalse content (colloquially \"hallucinations\" or\n\"fabrications\") by which users may be misled or deceived."
        },
        {
          "text": "DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT",
          "description": "Eased production of and access to violent, inciting,\nradicalizing, or threatening content as well as\nrecommendations to carry out self-harm or conduct illegal\nactivities. Includes difficulty controlling public\nexposure to hateful and disparaging or stereotyping\ncontent."
        },
        {
          "text": "DATA_PRIVACY",
          "description": "Impacts due to leakage and unauthorized use, disclosure, or\nde-anonymization of biometric, health, location, or other\npersonally identifiable information or sensitive data."
        },
        {
          "text": "ENVIRONMENTAL_IMPACTS",
          "description": "Impacts due to high compute resource utilization in\ntraining or operating GAI models, and related outcomes that\nmay adversely impact ecosystems."
        },
        {
          "text": "HARMFUL_BIAS_OR_HOMOGENIZATION",
          "description": "Amplification and exacerbation of historical, societal,\nand systemic biases; performance disparities between\nsub-groups or languages, possibly due to non-representative\ntraining data, resulting in discrimination, amplification\nof biases, or incorrect presumptions about performance;\nundesired homogeneity that skews system or model outputs."
        },
        {
          "text": "HUMAN_AI_CONFIGURATION",
          "description": "Arrangements of or interactions between a human and an AI\nsystem which can result in the human inappropriately\nanthropomorphising GAI systems or experiencing algorithmic\naversion, automation bias, over-reliance, or emotional\nentanglement with GAI systems."
        },
        {
          "text": "INFORMATION_INTEGRITY",
          "description": "Lowered barrier to entry to generate and support the\nexchange and consumption of content which may not\ndistinguish fact from opinion or fiction or acknowledge\nuncertainties, or could be leveraged for large-scale\ndis- and mis-information campaigns."
        },
        {
          "text": "INFORMATION_SECURITY",
          "description": "Lowered barriers for offensive cyber capabilities,\nincluding via automated discovery and exploitation of\nvulnerabilities; increased attack surface for targeted\ncyberattacks, which may compromise a system's availability\nor the confidentiality or integrity of training data,\ncode, or model weights."
        },
        {
          "text": "INTELLECTUAL_PROPERTY",
          "description": "Eased production or replication of alleged copyrighted,\ntrademarked, or licensed content without authorization\n(possibly outside fair use); eased exposure of trade\nsecrets; or plagiarism or illegal replication."
        },
        {
          "text": "OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT",
          "description": "Eased production of and access to obscene, degrading,\nand/or abusive imagery which can cause harm, including\nsynthetic child sexual abuse material (CSAM) and\nnonconsensual intimate images (NCII) of adults."
        },
        {
          "text": "VALUE_CHAIN_AND_COMPONENT_INTEGRATION",
          "description": "Non-transparent or untraceable integration of upstream\nthird-party components, including data that has been\nimproperly obtained or not processed and cleaned due to\nincreased automation from GAI; improper supplier vetting\nacross the AI lifecycle; or other issues that diminish\ntransparency or accountability for downstream users."
        }
      ]
    },
    {
      "name": "GaiRiskCategorizationEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum",
      "description": "Higher-level grouping of GAI risks, derived from the UK's\nInternational Scientific Report on the Safety of Advanced AI\n(NIST AI 600-1 Section 2, footnote 5).",
      "in_subset": [
        "gai_core"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "TECHNICAL_OR_MODEL_RISKS",
          "description": "Risks from malfunction. Examples include confabulation;\ndangerous or violent recommendations; data privacy; value\nchain and component integration; harmful bias and\nhomogenization."
        },
        {
          "text": "MISUSE_BY_HUMANS",
          "description": "Risks from malicious use. Examples include CBRN information\nor capabilities; data privacy; human-AI configuration;\nobscene, degrading, and/or abusive content; information\nintegrity; information security."
        },
        {
          "text": "ECOSYSTEM_OR_SOCIETAL_RISKS",
          "description": "Systemic risks. Examples include data privacy;\nenvironmental impacts; intellectual property."
        }
      ]
    },
    {
      "name": "GaiRiskScopeEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum",
      "description": "The scope at which a GAI risk may manifest (Section 2).",
      "in_subset": [
        "gai_core"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "MODEL_OR_SYSTEM",
          "description": "Individual GAI model or system level."
        },
        {
          "text": "APPLICATION_OR_IMPLEMENTATION",
          "description": "Specific application or implementation - i.e., a particular\nuse case."
        },
        {
          "text": "ECOSYSTEM",
          "description": "Beyond a single system or organizational context - e.g.,\nalgorithmic monocultures, labor-market impacts, creative\neconomies."
        }
      ]
    },
    {
      "name": "GaiRiskSourceEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum",
      "description": "The source(s) from which a GAI risk may emerge (Section 2).",
      "in_subset": [
        "gai_core"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "DESIGN",
          "description": "From decisions made during model or system design."
        },
        {
          "text": "TRAINING",
          "description": "From the training data or training process."
        },
        {
          "text": "OPERATION",
          "description": "From operating the GAI model or system."
        },
        {
          "text": "MODEL_INPUTS",
          "description": "From inputs supplied to the model at inference time."
        },
        {
          "text": "MODEL_OUTPUTS",
          "description": "From the GAI system's generated outputs."
        },
        {
          "text": "HUMAN_BEHAVIOR",
          "description": "From human behaviour - abuse, misuse, or unsafe repurposing\nby humans (adversarial or not)."
        },
        {
          "text": "HUMAN_AI_INTERACTION",
          "description": "From interactions between a human and the AI system."
        }
      ]
    },
    {
      "name": "GaiRiskTimeScaleEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum",
      "description": "The time scale over which a GAI risk may materialise\n(Section 2).",
      "in_subset": [
        "gai_core"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "IMMEDIATE",
          "description": "Materialises abruptly (e.g., distribution of deepfakes)."
        },
        {
          "text": "PROLONGED",
          "description": "Materialises across extended periods (e.g., long-term\neffect of disinformation on societal trust)."
        }
      ]
    },
    {
      "name": "GaiActionFunctionPrefixEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum",
      "description": "Two-letter function prefix used in GAI Action IDs.",
      "in_subset": [
        "gai_actions"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "GV",
          "description": "Govern function."
        },
        {
          "text": "MP",
          "description": "Map function."
        },
        {
          "text": "MS",
          "description": "Measure function."
        },
        {
          "text": "MG",
          "description": "Manage function."
        }
      ]
    },
    {
      "name": "PrimaryConsiderationEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum",
      "description": "The four overarching themes derived from the GAI PWG\nconsultation process (Appendix A).",
      "in_subset": [
        "gai_considerations"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "GOVERNANCE",
          "description": "How organizational governance regimes may be re-evaluated\nand adjusted for GAI contexts (A.1)."
        },
        {
          "text": "PRE_DEPLOYMENT_TESTING",
          "description": "Test, evaluation, validation, and verification practices\nappropriate for GAI prior to deployment (A.1.4)."
        },
        {
          "text": "CONTENT_PROVENANCE",
          "description": "Digital transparency mechanisms (provenance data tracking,\nwatermarking, synthetic content detection) for tracing\norigin and history of content (A.1.6 - A.1.7)."
        },
        {
          "text": "INCIDENT_DISCLOSURE",
          "description": "Documenting, reporting, and sharing information about AI\nincidents to mitigate harm and improve risk management\n(A.1.8)."
        }
      ]
    },
    {
      "name": "StructuredFeedbackMethodEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum",
      "description": "Categories of structured public feedback for GAI risk\nmanagement (Appendix A.1.5).",
      "in_subset": [
        "gai_feedback"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "PARTICIPATORY_ENGAGEMENT_METHODS",
          "description": "Methods used to solicit feedback from civil society groups,\naffected communities, and users (focus groups, small user\nstudies, surveys)."
        },
        {
          "text": "FIELD_TESTING",
          "description": "Methods used to determine how people interact with,\nconsume, use, and make sense of AI-generated information\n(UX, usability, randomised experiments)."
        },
        {
          "text": "AI_RED_TEAMING",
          "description": "A structured testing exercise used to probe an AI system\nto find flaws and vulnerabilities such as inaccurate,\nharmful, or discriminatory outputs."
        }
      ]
    },
    {
      "name": "RedTeamingTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum",
      "description": "Types of AI red-teaming exercises (Appendix A.1.5).",
      "in_subset": [
        "gai_feedback"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "GENERAL_PUBLIC",
          "description": "Performed by general users not necessarily having AI or\ntechnical expertise."
        },
        {
          "text": "EXPERT",
          "description": "Performed by specialists with expertise in the domain or\nspecific red-teaming context (medicine, biotech,\ncybersecurity)."
        },
        {
          "text": "COMBINATION",
          "description": "Hybrid exercises using both expert and general-public\nparticipants."
        },
        {
          "text": "HUMAN_AND_AI",
          "description": "Performed by GAI in combination with specialist or\nnon-specialist human teams."
        }
      ]
    },
    {
      "name": "ProvenanceTechniqueEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum",
      "description": "Provenance data tracking techniques for GAI content\n(Appendix A.1.6). \"Some well-known techniques for provenance\ndata tracking include digital watermarking, metadata\nrecording, digital fingerprinting, and human authentication,\namong others.\"",
      "in_subset": [
        "gai_considerations"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "DIGITAL_WATERMARKING",
          "description": "Overt or covert digital watermarks embedded in content to\nallow downstream verification of origin."
        },
        {
          "text": "METADATA_RECORDING",
          "description": "Recording metadata about content (creator, date/time,\nlocation, modifications, sources) for text, image, video,\naudio, or underlying datasets."
        },
        {
          "text": "DIGITAL_FINGERPRINTING",
          "description": "Computing a content-derived identifier that can be matched\nagainst a reference store to detect known content."
        },
        {
          "text": "HUMAN_AUTHENTICATION",
          "description": "Human-mediated verification of content origin or\nauthenticity."
        }
      ]
    },
    {
      "name": "GovernancePracticeEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum",
      "description": "Governance plans and actions for GAI systems enumerated in\nNIST AI 600-1 Appendix A.1.2 (\"Organizational Governance\").",
      "in_subset": [
        "gai_considerations"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "permissible_values": [
        {
          "text": "ACCESSIBILITY_AND_REASONABLE_ACCOMMODATIONS",
          "description": "Accessibility and reasonable accommodations."
        },
        {
          "text": "AI_ACTOR_CREDENTIALS_AND_QUALIFICATIONS",
          "description": "AI actor credentials and qualifications."
        },
        {
          "text": "ALIGNMENT_TO_ORGANIZATIONAL_VALUES",
          "description": "Alignment to organizational values."
        },
        {
          "text": "AUDITING_AND_ASSESSMENT",
          "description": "Auditing and assessment."
        },
        {
          "text": "CHANGE_MANAGEMENT_CONTROLS",
          "description": "Change-management controls."
        },
        {
          "text": "COMMERCIAL_USE",
          "description": "Commercial use governance."
        },
        {
          "text": "DATA_PROVENANCE",
          "description": "Data provenance."
        },
        {
          "text": "DATA_PROTECTION",
          "description": "Data protection."
        },
        {
          "text": "DATA_RETENTION",
          "description": "Data retention."
        },
        {
          "text": "CONSISTENCY_IN_USE_OF_DEFINING_KEY_TERMS",
          "description": "Consistency in use of defining key terms."
        },
        {
          "text": "DECOMMISSIONING",
          "description": "Decommissioning practices."
        },
        {
          "text": "DISCOURAGING_ANONYMOUS_USE",
          "description": "Discouraging anonymous use."
        },
        {
          "text": "EDUCATION",
          "description": "Education on GAI risks and responsible use."
        },
        {
          "text": "IMPACT_ASSESSMENTS",
          "description": "Impact assessments."
        },
        {
          "text": "INCIDENT_RESPONSE",
          "description": "Incident response procedures."
        },
        {
          "text": "MONITORING",
          "description": "Ongoing monitoring of GAI systems."
        },
        {
          "text": "OPT_OUTS",
          "description": "User opt-out mechanisms."
        },
        {
          "text": "RISK_BASED_CONTROLS",
          "description": "Risk-based controls."
        },
        {
          "text": "RISK_MAPPING_AND_MEASUREMENT",
          "description": "Risk mapping and measurement."
        },
        {
          "text": "SCIENCE_BACKED_TEVV_PRACTICES",
          "description": "Science-backed test, evaluation, validation, and verification practices."
        },
        {
          "text": "SECURE_SOFTWARE_DEVELOPMENT_PRACTICES",
          "description": "Secure software development practices."
        },
        {
          "text": "STAKEHOLDER_ENGAGEMENT",
          "description": "Stakeholder engagement."
        },
        {
          "text": "SYNTHETIC_CONTENT_DETECTION_AND_LABELING",
          "description": "Synthetic content detection and labeling tools and techniques."
        },
        {
          "text": "WHISTLEBLOWER_PROTECTIONS",
          "description": "Whistleblower protections."
        },
        {
          "text": "WORKFORCE_DIVERSITY_AND_INTERDISCIPLINARY_TEAMS",
          "description": "Workforce diversity and interdisciplinary teams."
        }
      ]
    },
    {
      "name": "TrustworthinessCharacteristicEnum",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum",
      "description": "The seven characteristics of trustworthy AI systems described in\nFigure 4 and Part 1 \u00a73.",
      "in_subset": [
        "trustworthiness"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common",
      "permissible_values": [
        {
          "text": "VALID_AND_RELIABLE",
          "description": "Confirmation that requirements for a specific intended use have\nbeen fulfilled (validation) and that the system performs as\nrequired without failure (reliability). A necessary condition of\ntrustworthiness and the base for other characteristics."
        },
        {
          "text": "SAFE",
          "description": "The system does not, under defined conditions, lead to a state\nin which human life, health, property, or the environment is\nendangered."
        },
        {
          "text": "SECURE_AND_RESILIENT",
          "description": "The system can withstand unexpected adverse events or changes\n(resilient) and maintain confidentiality, integrity, and\navailability through protection mechanisms (secure)."
        },
        {
          "text": "ACCOUNTABLE_AND_TRANSPARENT",
          "description": "Trustworthy AI depends on accountability, which presupposes\ntransparency - the extent to which information about an AI\nsystem and its outputs is available to those interacting with\nit."
        },
        {
          "text": "EXPLAINABLE_AND_INTERPRETABLE",
          "description": "Explainability concerns the mechanisms underlying an AI system's\noperation; interpretability concerns the meaning of its output\nin context."
        },
        {
          "text": "PRIVACY_ENHANCED",
          "description": "Norms and practices that help safeguard human autonomy,\nidentity, and dignity - including anonymity, confidentiality,\nand control over personal information."
        },
        {
          "text": "FAIR_WITH_HARMFUL_BIAS_MANAGED",
          "description": "Concerns for equality and equity by addressing issues such as\nharmful bias and discrimination, and recognising that\nperceptions of fairness differ across cultures and\napplications."
        }
      ]
    }
  ],
