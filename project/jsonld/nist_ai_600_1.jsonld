  "classes": [
    {
      "name": "GaiProfile",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiProfile",
      "description": "The Generative AI Profile as a whole, a cross-sectoral profile of the AI RMF and a companion resource to it.",
      "comments": [
        "It holds actions for only some subcategories, and the publication says more may be added later."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "exact_mappings": [
        "nist_ai_600_1:Profile"
      ],
      "is_a": "AiRmfProfile",
      "slots": [
        "ai_rmf_id",
        "title",
        "description",
        "aiRmfProfile__ai_rmf_profile_kinds",
        "aiRmfProfile__ai_rmf_profile_setting",
        "aiRmfProfile__ai_rmf_profile_subcategories",
        "gaiProfile__gai_risks",
        "gaiProfile__gai_subcategories",
        "gaiProfile__gai_primary_considerations"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "gai_risks",
          "description": "The 12 risks of section 2.",
          "range": "GaiRisk",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_subcategories",
          "description": "The tables of section 3, in the publication's order.",
          "range": "GaiSubcategory",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_primary_considerations",
          "description": "The four primary considerations of Appendix A.",
          "range": "GaiPrimaryConsideration",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-ai-600-1/Profile",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "AiRmfRecord",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/AiRmfRecord",
      "description": "The base of the classes that record an adopter's own facts, such as one of its AI systems or risks, as distinct from what the publication itself lists.",
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base",
      "exact_mappings": [
        "nist_ai_100_1:Record"
      ],
      "abstract": true,
      "slots": [
        "ai_rmf_id",
        "title",
        "description"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/nist-ai-100-1/Record",
      "@type": "ClassDefinition"
    },
    {
      "name": "AiRmfProfile",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfile",
      "description": "An implementation of the Core's functions, categories and subcategories for a setting, application or technology, based on the adopter's requirements, risk tolerance and resources.",
      "comments": [
        "The publication prescribes no profile template, so only the kinds and the subcategories are structured."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_profiles",
      "exact_mappings": [
        "nist_ai_100_1:Profile"
      ],
      "related_mappings": [
        "oscal:Profile"
      ],
      "is_a": "AiRmfRecord",
      "slots": [
        "ai_rmf_id",
        "title",
        "description",
        "aiRmfProfile__ai_rmf_profile_kinds",
        "aiRmfProfile__ai_rmf_profile_setting",
        "aiRmfProfile__ai_rmf_profile_subcategories"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ai_rmf_profile_kinds",
          "description": "Which of the publication's kinds of profile this is. A current profile for one use case is both.",
          "range": "AiRmfProfileKind",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "ai_rmf_profile_setting",
          "description": "The sector, industry, technology, organization or end use the profile covers, such as hiring.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ai_rmf_profile_subcategories",
          "description": "The subcategories the profile selects. An adopter may select from them rather than apply all.",
          "range": "ai_rmf_subcategory_identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-ai-100-1/Profile",
      "@type": "ClassDefinition"
    },
    {
      "name": "GaiRisk",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/GaiRisk",
      "description": "A risk that section 2 defines as unique to or made worse by the development and use of GAI.",
      "comments": [
        "The publication gives a risk its section, its definition, its trustworthiness characteristics and, in a footnote, its groupings. It assigns no lifecycle stage, scope, source or time scale to a risk, since those depend on the model, system or use case. An adopter fills them in."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks",
      "exact_mappings": [
        "nist_ai_600_1:Risk"
      ],
      "related_mappings": [
        "nist_ai_100_1:Risk"
      ],
      "slots": [
        "GaiRisk_description",
        "gaiRisk__gai_risk_name",
        "gaiRisk__gai_risk_section",
        "gaiRisk__gai_risk_characteristics",
        "gaiRisk__gai_risk_groupings",
        "gaiRisk__gai_risk_lifecycle_stages",
        "gaiRisk__gai_risk_scopes",
        "gaiRisk__gai_risk_sources",
        "gaiRisk__gai_risk_time_scales"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "gai_risk_name",
          "description": "Which of the 12 risks this is.",
          "range": "GaiRiskName",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_risk_section",
          "description": "The subsection of section 2 that discusses the risk, such as 2.1.",
          "required": true,
          "pattern": "^2\\.([1-9]|1[0-2])$",
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_risk_characteristics",
          "description": "The AI RMF's trustworthiness characteristics that the subsection names for the risk.",
          "range": "AiRmfCharacteristicName",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_risk_groupings",
          "description": "The groups footnote 5 suggests for the risk. The footnote lists Data Privacy under all three.",
          "range": "GaiRiskGrouping",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_risk_lifecycle_stages",
          "description": "The lifecycle stages where the risk can arise for the adopter's model, system or use case.",
          "range": "GaiLifecycleStage",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_risk_scopes",
          "description": "The levels where the risk exists for the adopter's model, system or use case.",
          "range": "GaiRiskScope",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_risk_sources",
          "description": "Where the risk comes from for the adopter's model, system or use case.",
          "range": "GaiRiskSource",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gai_risk_time_scales",
          "description": "How the risk materializes over time for the adopter's model, system or use case.",
          "range": "GaiRiskTimeScale",
          "multivalued": true,
          "@type": "SlotDefinition"
