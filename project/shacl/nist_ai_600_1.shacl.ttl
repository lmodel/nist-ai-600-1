nist_ai_600_1:StructuredFeedback a sh:NodeShape ;
	rdfs:comment "A way of using structured public feedback to evaluate whether GAI systems perform as intended." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n101 ;
	sh:property _:c14n103 , _:c14n2 , _:c14n78 ;
