nist_ai_100_1:Profile a sh:NodeShape ;
	rdfs:comment "An implementation of the Core's functions, categories and subcategories for a setting, application or technology, based on the adopter's requirements, risk tolerance and resources." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n99 ;
	sh:property _:c14n108 , _:c14n142 , _:c14n151 , _:c14n171 , _:c14n24 , _:c14n96 ;
	sh:targetClass nist_ai_100_1:Profile .
nist_ai_100_1:Record a sh:NodeShape ;
	rdfs:comment "The base of the classes that record an adopter's own facts, such as one of its AI systems or risks, as distinct from what the publication itself lists." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n106 ;
	sh:property _:c14n145 , _:c14n44 , _:c14n54 ;
	sh:targetClass nist_ai_100_1:Record .
nist_ai_600_1:AiRedTeaming a sh:NodeShape ;
	rdfs:comment "A structured exercise that probes an AI system for flaws and vulnerabilities, often with its developers." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n18 ;
	sh:property _:c14n128 , _:c14n133 , _:c14n42 , _:c14n84 ;
	sh:targetClass nist_ai_600_1:AiRedTeaming .
nist_ai_600_1:ContentProvenanceConsideration a sh:NodeShape ;
	rdfs:comment "How tracking the origin and history of content helps tell authentic content from synthetic content." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n116 ;
	sh:property _:c14n131 , _:c14n143 , _:c14n150 , _:c14n41 , _:c14n62 ;
	sh:targetClass nist_ai_600_1:ContentProvenanceConsideration .
nist_ai_600_1:FieldTesting a sh:NodeShape ;
	rdfs:comment "Structured settings that show how people interact with and use AI-generated information." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n37 ;
	sh:property _:c14n146 , _:c14n156 , _:c14n3 ;
	sh:targetClass nist_ai_600_1:FieldTesting .
nist_ai_600_1:GovernanceConsideration a sh:NodeShape ;
	rdfs:comment "How an organization's governance can be revisited for GAI, including across the AI value chain." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n92 ;
	sh:property _:c14n117 , _:c14n134 , _:c14n165 , _:c14n167 , _:c14n40 , _:c14n80 ;
	sh:targetClass nist_ai_600_1:GovernanceConsideration .
nist_ai_600_1:IncidentDisclosureConsideration a sh:NodeShape ;
	rdfs:comment "How documenting, reporting and sharing AI incidents helps prevent harm, though no formal channels exist." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n48 ;
	sh:property _:c14n10 , _:c14n22 , _:c14n65 , _:c14n68 , _:c14n79 ;
	sh:targetClass nist_ai_600_1:IncidentDisclosureConsideration .
nist_ai_600_1:ParticipatoryEngagement a sh:NodeShape ;
	rdfs:comment "Asking civil society groups, affected communities and users for feedback, such as through focus groups or surveys." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n67 ;
	sh:property _:c14n124 , _:c14n141 , _:c14n98 ;
	sh:targetClass nist_ai_600_1:ParticipatoryEngagement .
nist_ai_600_1:PreDeploymentTestingConsideration a sh:NodeShape ;
	rdfs:comment "How GAI can be tested before deployment while better approaches mature, and where current tests fall short." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n88 ;
	sh:property _:c14n0 , _:c14n115 , _:c14n139 , _:c14n51 , _:c14n53 ;
	sh:targetClass nist_ai_600_1:PreDeploymentTestingConsideration .
nist_ai_600_1:PrimaryConsideration a sh:NodeShape ;
	rdfs:comment "One of the four primary considerations of Appendix A, which also inform the suggested actions." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n158 ;
	sh:property _:c14n149 , _:c14n15 , _:c14n52 , _:c14n69 ;
	sh:targetClass nist_ai_600_1:PrimaryConsideration .
nist_ai_600_1:Profile a sh:NodeShape ;
	rdfs:comment "The Generative AI Profile as a whole, a cross-sectoral profile of the AI RMF and a companion resource to it." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n89 ;
	sh:property _:c14n122 , _:c14n129 , _:c14n154 , _:c14n173 , _:c14n31 , _:c14n46 , _:c14n5 , _:c14n82 , _:c14n83 ;
