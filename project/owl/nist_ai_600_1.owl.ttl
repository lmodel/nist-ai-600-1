@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nist_ai_100_1: <https://w3id.org/lmodel/nist-ai-100-1/> .
@prefix nist_ai_600_1: <https://w3id.org/lmodel/nist-ai-600-1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n226 , _:c14n228 , _:c14n230 , _:c14n232 .
nist_ai_100_1:AiRmfProfile a owl:Class ;
	rdfs:label "AiRmfProfile" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfRecord , _:c14n149 , _:c14n163 , _:c14n186 , _:c14n204 , _:c14n210 , _:c14n41 , _:c14n57 ;
	skos:definition "An implementation of the Core's functions, categories and subcategories for a setting, application or technology, based on the adopter's requirements, risk tolerance and resources." ;
	skos:exactMatch nist_ai_100_1:Profile ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_profiles ;
	skos:note "The publication prescribes no profile template, so only the kinds and the subcategories are structured." ;
	skos:relatedMatch <https://w3id.org/lmodel/oscal/Profile> .
nist_ai_100_1:AiRmfRecord a owl:Class ;
	rdfs:label "AiRmfRecord" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfProfile , _:c14n147 , _:c14n162 , _:c14n166 , _:c14n173 , _:c14n202 , _:c14n38 , _:c14n72 , _:c14n95 , _:c14n97 ;
	skos:definition "The base of the classes that record an adopter's own facts, such as one of its AI systems or risks, as distinct from what the publication itself lists." ;
	skos:exactMatch nist_ai_100_1:Record ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base .
nist_ai_100_1:ai_rmf_id a owl:DatatypeProperty ;
	rdfs:label "ai_rmf_id" ;
	rdfs:range xsd:anyURI ;
	skos:definition "The identifier an adopter gives a record of its own." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base .
nist_ai_100_1:ai_rmf_profile_kinds a owl:ObjectProperty ;
	rdfs:label "ai_rmf_profile_kinds" ;
	skos:definition "Which of the publication's kinds of profile this is. A current profile for one use case is both." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_profiles .
nist_ai_100_1:ai_rmf_profile_setting a owl:DatatypeProperty ;
	rdfs:label "ai_rmf_profile_setting" ;
	skos:definition "The sector, industry, technology, organization or end use the profile covers, such as hiring." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_profiles .
nist_ai_100_1:ai_rmf_profile_subcategories a owl:DatatypeProperty ;
	rdfs:label "ai_rmf_profile_subcategories" ;
	skos:definition "The subcategories the profile selects. An adopter may select from them rather than apply all." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_profiles .
nist_ai_100_1:ai_rmf_subcategory_id a owl:DatatypeProperty ;
	rdfs:label "ai_rmf_subcategory_id" ;
	rdfs:range xsd:string ;
	skos:definition "The subcategory's identifier, such as GOVERN 1.1." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base .
nist_ai_100_1:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "What the element says or is." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base ;
	skos:note "It carries the IRI of LOKF's description, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
nist_ai_100_1:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "The element's name." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base ;
	skos:note "It carries the IRI of LOKF's title, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .
<https://w3id.org/lmodel/nist-ai-600-1.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://doi.org/10.6028/NIST.AI.600-1> ;
	dcterms:title "NIST AI RMF Generative AI Profile (NIST AI 600-1)" ;
	pav:version "1.0.0" ;
	a owl:Ontology ;
	rdfs:label "nist_ai_600_1" ;
	rdfs:seeAlso <https://airc.nist.gov/Home> , <https://doi.org/10.6028/NIST.AI.100-1> , <https://lmodel.github.io/nist-ai-600-1> ;
	skos:definition "A LinkML model of NIST AI 600-1, the Generative Artificial Intelligence Profile of the AI Risk Management Framework: its 12 risks, the suggested actions its tables list under AI RMF subcategories, and its four primary considerations." ;
	skos:note "It imports the base and profiles modules of lmodel/nist-ai-100-1, vendored under nist_ai_100_1/, so it needs no network. tests/test_schema_rules.py holds them to their hashes." , "The publication has no version number of its own, so the version is the 1.0.0 of the AI RMF it profiles, and source is the publication's digital object identifier. The release tags are the schema's own versions, and scripts/check_upstream_release.py reports when NIST changes the file." , "The publication is a work of the United States Government. NOTICE says what it allows. The schema's descriptions are this project's own words; NIST's text is in src/nist_ai_600_1/data/." ;
	nist_ai_600_1:publication_approved "2024-07-25" ;
	nist_ai_600_1:publication_date "2024-07" .
nist_ai_600_1:AiRmfActorTaskName\#affected_individuals_and_communities dcterms:title "Affected individuals/communities" ;
	a owl:Class ;
	rdfs:label "affected_individuals_and_communities" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:altLabel "Affected Individuals and Communities" ;
	skos:definition "Those directly or indirectly affected by the system or its output, whether or not they interact with it." .
nist_ai_600_1:AiRmfActorTaskName\#ai_deployment dcterms:title "AI Deployment" ;
	a owl:Class ;
	rdfs:label "ai_deployment" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Deciding how the system is used and putting it into production, including pilots and compliance checks." .
nist_ai_600_1:AiRmfActorTaskName\#ai_design dcterms:title "AI Design" ;
	a owl:Class ;
	rdfs:label "ai_design" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Setting what the system is for, planning and designing it, and gathering and preparing its data." .
nist_ai_600_1:AiRmfActorTaskName\#ai_development dcterms:title "AI Development" ;
	a owl:Class ;
	rdfs:label "ai_development" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Providing the initial infrastructure, and creating, selecting, calibrating, training and testing models." .
nist_ai_600_1:AiRmfActorTaskName\#ai_impact_assessment dcterms:title "AI Impact Assessment" ;
	a owl:Class ;
	rdfs:label "ai_impact_assessment" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Assessing accountability, harmful bias, impacts, product safety, liability and security." .
nist_ai_600_1:AiRmfActorTaskName\#domain_expert dcterms:title "Domain Expert" ;
	a owl:Class ;
	rdfs:label "domain_expert" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:altLabel "Domain Experts" ;
	skos:definition "Giving knowledge of the sector or setting where the system is used." .
nist_ai_600_1:AiRmfActorTaskName\#end_users dcterms:title "End users" ;
	a owl:Class ;
	rdfs:label "end_users" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:altLabel "End Users" , "End-Users" ;
	skos:definition "The people or groups who use the system, whether new to technology or expert in AI." .
nist_ai_600_1:AiRmfActorTaskName\#general_public dcterms:title "General public" ;
	a owl:Class ;
	rdfs:label "general_public" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Those most likely to experience the impacts directly, who may motivate what other AI actors do." .
nist_ai_600_1:AiRmfActorTaskName\#governance_and_oversight dcterms:title "Governance and Oversight" ;
	a owl:Class ;
	rdfs:label "governance_and_oversight" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Holding management, fiduciary and legal authority for the organization where the system is designed, developed or deployed." .
nist_ai_600_1:AiRmfActorTaskName\#human_factors dcterms:title "Human Factors" ;
	a owl:Class ;
	rdfs:label "human_factors" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Human-centered design and evaluation, involving end users and bringing context-specific norms and values into design." .
nist_ai_600_1:AiRmfActorTaskName\#operation_and_monitoring dcterms:title "Operation and Monitoring" ;
	a owl:Class ;
	rdfs:label "operation_and_monitoring" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Running the system and regularly assessing its output and impacts." .
nist_ai_600_1:AiRmfActorTaskName\#other_ai_actors dcterms:title "Other AI actors" ;
	a owl:Class ;
	rdfs:label "other_ai_actors" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Those who set norms or guidance on AI risk, such as standards bodies, advocacy groups and researchers." .
nist_ai_600_1:AiRmfActorTaskName\#procurement dcterms:title "Procurement" ;
	a owl:Class ;
	rdfs:label "procurement" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Buying AI from another party, under financial, legal or policy authority." .
nist_ai_600_1:AiRmfActorTaskName\#tevv dcterms:title "Test, Evaluation, Verification, and Validation (TEVV)" ;
	a owl:Class ;
	rdfs:label "tevv" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:altLabel "TEVV" ;
	skos:definition "Examining the system or its components and finding and fixing problems, throughout the lifecycle." .
nist_ai_600_1:AiRmfActorTaskName\#third_party_entities dcterms:title "Third-party entities" ;
	a owl:Class ;
	rdfs:label "third_party_entities" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfActorTaskName ;
	skos:definition "Outside organizations that supply or evaluate the data, models, systems or services an organization acquires." .
nist_ai_600_1:AiRmfActorTaskName a owl:Class ;
	rdfs:label "AiRmfActorTaskName" ;
	owl:unionOf _:c14n21 ;
	skos:definition "The ten AI actor tasks and five additional AI actors of Appendix A." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base ;
	skos:note "One list holds both kinds because NIST tags them together: the Playbook under its AI Actors key, and AI 600-1 under AI Actor Tasks. Each alias is the spelling those tags use where it differs from the title in Appendix A." ;
	linkml:permissible_values nist_ai_600_1:AiRmfActorTaskName\#affected_individuals_and_communities , nist_ai_600_1:AiRmfActorTaskName\#ai_deployment , nist_ai_600_1:AiRmfActorTaskName\#ai_design , nist_ai_600_1:AiRmfActorTaskName\#ai_development , nist_ai_600_1:AiRmfActorTaskName\#ai_impact_assessment , nist_ai_600_1:AiRmfActorTaskName\#domain_expert , nist_ai_600_1:AiRmfActorTaskName\#end_users , nist_ai_600_1:AiRmfActorTaskName\#general_public , nist_ai_600_1:AiRmfActorTaskName\#governance_and_oversight , nist_ai_600_1:AiRmfActorTaskName\#human_factors , nist_ai_600_1:AiRmfActorTaskName\#operation_and_monitoring , nist_ai_600_1:AiRmfActorTaskName\#other_ai_actors , nist_ai_600_1:AiRmfActorTaskName\#procurement , nist_ai_600_1:AiRmfActorTaskName\#tevv , nist_ai_600_1:AiRmfActorTaskName\#third_party_entities .
nist_ai_600_1:AiRmfCharacteristicName\#accountable_and_transparent dcterms:title "Accountable and Transparent" ;
	a owl:Class ;
	rdfs:label "accountable_and_transparent" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfCharacteristicName ;
	skos:definition "Answerable for outcomes, which rests on people being able to get information about the system and its outputs. Figure 4 shows it relating to all the others." .
nist_ai_600_1:AiRmfCharacteristicName\#explainable_and_interpretable dcterms:title "Explainable and Interpretable" ;
	a owl:Class ;
	rdfs:label "explainable_and_interpretable" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfCharacteristicName ;
	skos:definition "Its working can be represented (how a decision was made) and its output understood in context (why, and what it means for the user)." .
nist_ai_600_1:AiRmfCharacteristicName\#fair_with_harmful_bias_managed dcterms:title "Fair – with Harmful Bias Managed" ;
	a owl:Class ;
	rdfs:label "fair_with_harmful_bias_managed" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfCharacteristicName ;
	skos:definition "Addresses equality and equity, including harmful bias and discrimination, knowing that views of fairness differ across cultures and applications." .
nist_ai_600_1:AiRmfCharacteristicName\#privacy_enhanced dcterms:title "Privacy-Enhanced" ;
	a owl:Class ;
	rdfs:label "privacy_enhanced" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfCharacteristicName ;
	skos:definition "Guided by the norms and practices that protect human autonomy, identity and dignity, such as anonymity, confidentiality and control." .
nist_ai_600_1:AiRmfCharacteristicName\#safe dcterms:title "Safe" ;
	a owl:Class ;
	rdfs:label "safe" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfCharacteristicName ;
	skos:definition "Keeps people, property and the environment out of danger under defined conditions." .
nist_ai_600_1:AiRmfCharacteristicName\#secure_and_resilient dcterms:title "Secure and Resilient" ;
	a owl:Class ;
	rdfs:label "secure_and_resilient" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfCharacteristicName ;
	skos:definition "Withstands adverse events and recovers from them, and keeps confidentiality, integrity and availability through protections against attack." .
nist_ai_600_1:AiRmfCharacteristicName\#valid_and_reliable dcterms:title "Valid and Reliable" ;
	a owl:Class ;
	rdfs:label "valid_and_reliable" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfCharacteristicName ;
	skos:definition "Shown by evidence to meet the needs of its intended use, and works without failure over time. Figure 4 makes it a necessary condition for the others." .
nist_ai_600_1:AiRmfCharacteristicName a owl:Class ;
	rdfs:label "AiRmfCharacteristicName" ;
	owl:unionOf _:c14n190 ;
	skos:definition "The seven characteristics of trustworthy AI systems in section 3 of the publication." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base ;
	linkml:permissible_values nist_ai_600_1:AiRmfCharacteristicName\#accountable_and_transparent , nist_ai_600_1:AiRmfCharacteristicName\#explainable_and_interpretable , nist_ai_600_1:AiRmfCharacteristicName\#fair_with_harmful_bias_managed , nist_ai_600_1:AiRmfCharacteristicName\#privacy_enhanced , nist_ai_600_1:AiRmfCharacteristicName\#safe , nist_ai_600_1:AiRmfCharacteristicName\#secure_and_resilient , nist_ai_600_1:AiRmfCharacteristicName\#valid_and_reliable .
nist_ai_600_1:AiRmfProfileKind\#cross_sectoral dcterms:title "Cross-sectoral profile" ;
	a owl:Class ;
	rdfs:label "cross_sectoral" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfProfileKind ;
	skos:definition "Covers risks of models or applications used across use cases or sectors, or activities common to them, such as using large language models." .
nist_ai_600_1:AiRmfProfileKind\#current dcterms:title "Current Profile" ;
	a owl:Class ;
	rdfs:label "current" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfProfileKind ;
	skos:definition "A temporal profile saying how AI is managed today and the related risks, in terms of current outcomes." .
nist_ai_600_1:AiRmfProfileKind\#target dcterms:title "Target Profile" ;
	a owl:Class ;
	rdfs:label "target" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfProfileKind ;
	skos:definition "A temporal profile saying which outcomes the desired risk management goals need." .
nist_ai_600_1:AiRmfProfileKind\#use_case dcterms:title "Use-case profile" ;
	a owl:Class ;
	rdfs:label "use_case" ;
	rdfs:subClassOf nist_ai_600_1:AiRmfProfileKind ;
	skos:definition "The Core implemented for a specific setting or application." .
nist_ai_600_1:AiRmfProfileKind a owl:Class ;
	rdfs:label "AiRmfProfileKind" ;
	owl:unionOf _:c14n62 ;
	skos:definition "The kinds of AI RMF profile that section 6 names." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_profiles ;
	linkml:permissible_values nist_ai_600_1:AiRmfProfileKind\#cross_sectoral , nist_ai_600_1:AiRmfProfileKind\#current , nist_ai_600_1:AiRmfProfileKind\#target , nist_ai_600_1:AiRmfProfileKind\#use_case .
nist_ai_600_1:GaiAiRedTeaming a owl:Class ;
	rdfs:label "GaiAiRedTeaming" ;
	rdfs:subClassOf nist_ai_600_1:GaiStructuredFeedback , _:c14n103 , _:c14n143 ;
	skos:definition "A structured exercise that probes an AI system for flaws and vulnerabilities, often with its developers." ;
	skos:exactMatch nist_ai_600_1:AiRedTeaming ;
	skos:inScheme nist_ai_600_1:nist_ai_600_1_considerations .
nist_ai_600_1:GaiContentProvenanceConsideration a owl:Class ;
	rdfs:label "GaiContentProvenanceConsideration" ;
	rdfs:subClassOf nist_ai_600_1:GaiPrimaryConsideration , _:c14n138 , _:c14n56 ;
	skos:definition "How tracking the origin and history of content helps tell authentic content from synthetic content." ;
	skos:exactMatch nist_ai_600_1:ContentProvenanceConsideration ;
	skos:inScheme nist_ai_600_1:nist_ai_600_1_considerations .
nist_ai_600_1:GaiFieldTesting a owl:Class ;
	rdfs:label "GaiFieldTesting" ;
	rdfs:subClassOf nist_ai_600_1:GaiStructuredFeedback ;
	skos:definition "Structured settings that show how people interact with and use AI-generated information." ;
	skos:exactMatch nist_ai_600_1:FieldTesting ;
	skos:inScheme nist_ai_600_1:nist_ai_600_1_considerations .
nist_ai_600_1:GaiGovernanceConsideration a owl:Class ;
	rdfs:label "GaiGovernanceConsideration" ;
	rdfs:subClassOf nist_ai_600_1:GaiPrimaryConsideration , _:c14n129 , _:c14n135 , _:c14n5 , _:c14n81 ;
	skos:definition "How an organization's governance can be revisited for GAI, including across the AI value chain." ;
	skos:exactMatch nist_ai_600_1:GovernanceConsideration ;
	skos:inScheme nist_ai_600_1:nist_ai_600_1_considerations .
