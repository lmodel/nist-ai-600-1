@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gist_linkml: <https://w3id.org/lmodel/gist/> .
@prefix iso27001: <https://w3id.org/lmodel/iso27001/> .
@prefix iso29100: <https://w3id.org/lmodel/iso29100/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nist_ai_100_1: <https://w3id.org/lmodel/nist-ai-100-1/> .
@prefix nist_ai_600_1: <https://w3id.org/lmodel/nist-ai-600-1/> .
@prefix nist_csf: <https://w3id.org/lmodel/nist-csf-v2/> .
@prefix oscal_catalog: <https://w3id.org/lmodel/oscal_catalog/> .
@prefix oscal_profile: <https://w3id.org/lmodel/oscal_profile/> .
@prefix owasp_asi: <https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/asi-> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stix: <https://w3id.org/lmodel/stix/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/nist-ai-600-1.owl.ttl> a owl:Ontology ;
    rdfs:label "nist-ai-600-1" ;
    dcterms:license "Apache-2.0" ;
    dcterms:source <https://doi.org/10.6028/NIST.AI.600-1> ;
    dcterms:title "NIST AI RMF Generative AI Profile (NIST AI 600-1)" ;
    pav:version "1.0.0" ;
    rdfs:seeAlso <https://airc.nist.gov/Home>,
        <https://doi.org/10.6028/NIST.AI.100-1>,
        <https://doi.org/10.6028/NIST.AI.600-1> ;
    skos:definition """LinkML schema for NIST AI 600-1, the Generative Artificial Intelligence
Profile of the AI Risk Management Framework (July 2024).

This is a **cross-sectoral profile** and a *companion resource* to
NIST AI 100-1 (AI RMF 1.0). It defines risks that are novel to or
exacerbated by the use of Generative AI (GAI) and provides a set of
suggested actions, organised by AI RMF subcategory, that
organisations can take to govern, map, measure, and manage those
risks.

Shared AI RMF base scaffolding (the abstract `NamedThing` root,
identifier/title/description slots, the `SubcategoryCode` type, and
the `TrustworthinessCharacteristicEnum`) is imported from the
`nist_ai_rmf_common` module so it has a single canonical definition
across the framework. GAI-specific lifecycle and actor-task
vocabularies (`GaiLifecycleStageEnum`, `GaiActorTaskEnum`) are
defined locally because they diverge from the NIST AI 100-1 enums;
cross-references to AI RMF 1.0 elements are recorded as `*_mappings`
for traceability.

The schema covers:
  * 12 GAI risk categories (Section 2)
  * Risk dimensions (lifecycle stage, scope, source, time scale)
  * `SuggestedAction` entries (Section 3 tables) linked to AI RMF
    subcategories
  * Primary GAI Considerations (Appendix A): Governance,
    Pre-Deployment Testing, Content Provenance, Incident Disclosure
  * Structured Public Feedback methods and AI Red-teaming types""" .

nist_ai_600_1:AiRedTeaming a owl:Class ;
    rdfs:label "AiRedTeaming" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:red_team_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:RedTeamingTypeEnum ;
            owl:onProperty nist_ai_600_1:red_team_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:red_team_type ],
        nist_ai_600_1:StructuredPublicFeedback ;
    skos:definition """A structured testing exercise used to probe an AI system to
find flaws and vulnerabilities such as inaccurate, harmful, or
discriminatory outputs, often in a controlled environment and
in collaboration with system developers (A.1.5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch stix:AttackPattern .

nist_ai_600_1:GaiProfile a owl:Class ;
    rdfs:label "GaiProfile" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:StructuredPublicFeedback ;
            owl:onProperty nist_ai_600_1:structured_feedback_methods ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:suggested_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:primary_considerations ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:SuggestedAction ;
            owl:onProperty nist_ai_600_1:suggested_actions ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:PrimaryGaiConsideration ;
            owl:onProperty nist_ai_600_1:primary_considerations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:structured_feedback_methods ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:gai_risk_catalog ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiRisk ;
            owl:onProperty nist_ai_600_1:gai_risk_catalog ],
        nist_ai_100_1:NamedThing ;
    skos:closeMatch nist_csf:CSFDocument ;
    skos:definition """Root container that bundles the NIST AI 600-1 Generative AI
Profile: GAI risks (Section 2), suggested actions (Section 3),
and primary considerations (Appendix A). The GAI Profile is a
*cross-sectoral* AI RMF profile (Section 1).""" ;
    skos:exactMatch oscal_profile:Profile ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch nist_ai_100_1:AiRmfProfile .

nist_ai_100_1:see_also a owl:DatatypeProperty ;
    rdfs:label "see_also" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Related references." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common> .

nist_ai_100_1:trustworthiness_characteristic a owl:ObjectProperty ;
    rdfs:label "trustworthiness_characteristic" ;
    rdfs:range nist_ai_600_1:TrustworthinessCharacteristicEnum ;
    skos:definition "Trustworthiness characteristic(s) the element pertains to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common> .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#GV> a owl:Class ;
    rdfs:label "GV" ;
    rdfs:subClassOf nist_ai_600_1:GaiActionFunctionPrefixEnum ;
    skos:definition "Govern function." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MG> a owl:Class ;
    rdfs:label "MG" ;
    rdfs:subClassOf nist_ai_600_1:GaiActionFunctionPrefixEnum ;
    skos:definition "Manage function." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MP> a owl:Class ;
    rdfs:label "MP" ;
    rdfs:subClassOf nist_ai_600_1:GaiActionFunctionPrefixEnum ;
    skos:definition "Map function." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MS> a owl:Class ;
    rdfs:label "MS" ;
    rdfs:subClassOf nist_ai_600_1:GaiActionFunctionPrefixEnum ;
    skos:definition "Measure function." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#AFFECTED_INDIVIDUALS_AND_COMMUNITIES> a owl:Class ;
    rdfs:label "AFFECTED_INDIVIDUALS_AND_COMMUNITIES" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Individuals, groups, or communities directly or indirectly affected." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#AI_DEPLOYMENT> a owl:Class ;
    rdfs:label "AI_DEPLOYMENT" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Contextual decisions on how the AI system is used and deployed." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#AI_DESIGN> a owl:Class ;
    rdfs:label "AI_DESIGN" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Concept, objectives, planning, design, and data collection." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#AI_DEVELOPMENT> a owl:Class ;
    rdfs:label "AI_DEVELOPMENT" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Model building, selection, calibration, training, and testing." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#AI_IMPACT_ASSESSMENT> a owl:Class ;
    rdfs:label "AI_IMPACT_ASSESSMENT" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Assessing accountability, bias, impacts, safety, liability, security." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#DOMAIN_EXPERTS> a owl:Class ;
    rdfs:label "DOMAIN_EXPERTS" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Multidisciplinary practitioners with sector or context expertise." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#END_USERS> a owl:Class ;
    rdfs:label "END_USERS" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Individuals or groups using the AI system for specific purposes." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT> a owl:Class ;
    rdfs:label "GOVERNANCE_AND_OVERSIGHT" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Management, fiduciary, and legal authority for the organization." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#HUMAN_FACTORS> a owl:Class ;
    rdfs:label "HUMAN_FACTORS" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Human-centered design practices and end-user involvement." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#OPERATION_AND_MONITORING> a owl:Class ;
    rdfs:label "OPERATION_AND_MONITORING" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Operating the AI system and assessing system output and impacts." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#PROCUREMENT> a owl:Class ;
    rdfs:label "PROCUREMENT" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Acquisition of AI models, products, or services from third parties." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#TEVV> a owl:Class ;
    rdfs:label "TEVV" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Test, Evaluation, Verification, and Validation tasks." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiActorTaskEnum#THIRD_PARTY_ENTITIES> a owl:Class ;
    rdfs:label "THIRD_PARTY_ENTITIES" ;
    rdfs:subClassOf nist_ai_600_1:GaiActorTaskEnum ;
    skos:definition "Providers, developers, vendors, and evaluators external to the deploying organization." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DECOMMISSIONING> a owl:Class ;
    rdfs:label "DECOMMISSIONING" ;
    rdfs:subClassOf nist_ai_600_1:GaiLifecycleStageEnum ;
    skos:definition "Retiring or phasing out the GAI system." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEPLOYMENT> a owl:Class ;
    rdfs:label "DEPLOYMENT" ;
    rdfs:subClassOf nist_ai_600_1:GaiLifecycleStageEnum ;
    skos:definition "Placing the GAI system into a production environment." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DESIGN> a owl:Class ;
    rdfs:label "DESIGN" ;
    rdfs:subClassOf nist_ai_600_1:GaiLifecycleStageEnum ;
    skos:definition "Articulating system concept, objectives, requirements." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEVELOPMENT> a owl:Class ;
    rdfs:label "DEVELOPMENT" ;
    rdfs:subClassOf nist_ai_600_1:GaiLifecycleStageEnum ;
    skos:definition "Building, training, and tuning the GAI model or system." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#OPERATION> a owl:Class ;
    rdfs:label "OPERATION" ;
    rdfs:subClassOf nist_ai_600_1:GaiLifecycleStageEnum ;
    skos:definition "Running and monitoring the GAI system in use." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#ECOSYSTEM_OR_SOCIETAL_RISKS> a owl:Class ;
    rdfs:label "ECOSYSTEM_OR_SOCIETAL_RISKS" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategorizationEnum ;
    skos:definition """Systemic risks. Examples include data privacy;
environmental impacts; intellectual property.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#MISUSE_BY_HUMANS> a owl:Class ;
    rdfs:label "MISUSE_BY_HUMANS" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategorizationEnum ;
    skos:definition """Risks from malicious use. Examples include CBRN information
or capabilities; data privacy; human-AI configuration;
obscene, degrading, and/or abusive content; information
integrity; information security.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#TECHNICAL_OR_MODEL_RISKS> a owl:Class ;
    rdfs:label "TECHNICAL_OR_MODEL_RISKS" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategorizationEnum ;
    skos:definition """Risks from malfunction. Examples include confabulation;
dangerous or violent recommendations; data privacy; value
chain and component integration; harmful bias and
homogenization.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CBRN_INFORMATION_OR_CAPABILITIES> a owl:Class ;
    rdfs:label "CBRN_INFORMATION_OR_CAPABILITIES" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """Eased access to or synthesis of materially nefarious
information or design capabilities related to chemical,
biological, radiological, or nuclear (CBRN) weapons or
other dangerous materials or agents.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CONFABULATION> a owl:Class ;
    rdfs:label "CONFABULATION" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """The production of confidently stated but erroneous or
false content (colloquially "hallucinations" or
"fabrications") by which users may be misled or deceived.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT> a owl:Class ;
    rdfs:label "DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """Eased production of and access to violent, inciting,
radicalizing, or threatening content as well as
recommendations to carry out self-harm or conduct illegal
activities. Includes difficulty controlling public
exposure to hateful and disparaging or stereotyping
content.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DATA_PRIVACY> a owl:Class ;
    rdfs:label "DATA_PRIVACY" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """Impacts due to leakage and unauthorized use, disclosure, or
de-anonymization of biometric, health, location, or other
personally identifiable information or sensitive data.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#ENVIRONMENTAL_IMPACTS> a owl:Class ;
    rdfs:label "ENVIRONMENTAL_IMPACTS" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """Impacts due to high compute resource utilization in
training or operating GAI models, and related outcomes that
may adversely impact ecosystems.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#HARMFUL_BIAS_OR_HOMOGENIZATION> a owl:Class ;
    rdfs:label "HARMFUL_BIAS_OR_HOMOGENIZATION" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """Amplification and exacerbation of historical, societal,
and systemic biases; performance disparities between
sub-groups or languages, possibly due to non-representative
training data, resulting in discrimination, amplification
of biases, or incorrect presumptions about performance;
undesired homogeneity that skews system or model outputs.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#HUMAN_AI_CONFIGURATION> a owl:Class ;
    rdfs:label "HUMAN_AI_CONFIGURATION" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:closeMatch owasp_asi:08,
        owasp_asi:09,
        owasp_asi:10 ;
    skos:definition """Arrangements of or interactions between a human and an AI
system which can result in the human inappropriately
anthropomorphising GAI systems or experiencing algorithmic
aversion, automation bias, over-reliance, or emotional
entanglement with GAI systems.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_INTEGRITY> a owl:Class ;
    rdfs:label "INFORMATION_INTEGRITY" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:closeMatch owasp_asi:01,
        owasp_asi:06 ;
    skos:definition """Lowered barrier to entry to generate and support the
exchange and consumption of content which may not
distinguish fact from opinion or fiction or acknowledge
uncertainties, or could be leveraged for large-scale
dis- and mis-information campaigns.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_SECURITY> a owl:Class ;
    rdfs:label "INFORMATION_SECURITY" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:closeMatch owasp_asi:02,
        owasp_asi:03,
        owasp_asi:05,
        owasp_asi:07 ;
    skos:definition """Lowered barriers for offensive cyber capabilities,
including via automated discovery and exploitation of
vulnerabilities; increased attack surface for targeted
cyberattacks, which may compromise a system's availability
or the confidentiality or integrity of training data,
code, or model weights.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INTELLECTUAL_PROPERTY> a owl:Class ;
    rdfs:label "INTELLECTUAL_PROPERTY" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """Eased production or replication of alleged copyrighted,
trademarked, or licensed content without authorization
(possibly outside fair use); eased exposure of trade
secrets; or plagiarism or illegal replication.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT> a owl:Class ;
    rdfs:label "OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """Eased production of and access to obscene, degrading,
and/or abusive imagery which can cause harm, including
synthetic child sexual abuse material (CSAM) and
nonconsensual intimate images (NCII) of adults.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#VALUE_CHAIN_AND_COMPONENT_INTEGRATION> a owl:Class ;
    rdfs:label "VALUE_CHAIN_AND_COMPONENT_INTEGRATION" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:closeMatch owasp_asi:04 ;
    skos:definition """Non-transparent or untraceable integration of upstream
third-party components, including data that has been
improperly obtained or not processed and cleaned due to
increased automation from GAI; improper supplier vetting
across the AI lifecycle; or other issues that diminish
transparency or accountability for downstream users.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#APPLICATION_OR_IMPLEMENTATION> a owl:Class ;
    rdfs:label "APPLICATION_OR_IMPLEMENTATION" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskScopeEnum ;
    skos:definition """Specific application or implementation - i.e., a particular
use case.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#ECOSYSTEM> a owl:Class ;
    rdfs:label "ECOSYSTEM" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskScopeEnum ;
    skos:definition """Beyond a single system or organizational context - e.g.,
algorithmic monocultures, labor-market impacts, creative
economies.""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#MODEL_OR_SYSTEM> a owl:Class ;
    rdfs:label "MODEL_OR_SYSTEM" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskScopeEnum ;
    skos:definition "Individual GAI model or system level." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#DESIGN> a owl:Class ;
    rdfs:label "DESIGN" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskSourceEnum ;
    skos:definition "From decisions made during model or system design." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#HUMAN_AI_INTERACTION> a owl:Class ;
    rdfs:label "HUMAN_AI_INTERACTION" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskSourceEnum ;
    skos:definition "From interactions between a human and the AI system." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#HUMAN_BEHAVIOR> a owl:Class ;
    rdfs:label "HUMAN_BEHAVIOR" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskSourceEnum ;
    skos:definition """From human behaviour - abuse, misuse, or unsafe repurposing
by humans (adversarial or not).""" .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_INPUTS> a owl:Class ;
    rdfs:label "MODEL_INPUTS" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskSourceEnum ;
    skos:definition "From inputs supplied to the model at inference time." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_OUTPUTS> a owl:Class ;
    rdfs:label "MODEL_OUTPUTS" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskSourceEnum ;
    skos:definition "From the GAI system's generated outputs." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#OPERATION> a owl:Class ;
    rdfs:label "OPERATION" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskSourceEnum ;
    skos:definition "From operating the GAI model or system." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#TRAINING> a owl:Class ;
    rdfs:label "TRAINING" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskSourceEnum ;
    skos:definition "From the training data or training process." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#IMMEDIATE> a owl:Class ;
    rdfs:label "IMMEDIATE" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskTimeScaleEnum ;
    skos:definition "Materialises abruptly (e.g., distribution of deepfakes)." .

<https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#PROLONGED> a owl:Class ;
    rdfs:label "PROLONGED" ;
    rdfs:subClassOf nist_ai_600_1:GaiRiskTimeScaleEnum ;
    skos:definition """Materialises across extended periods (e.g., long-term
effect of disinformation on societal trust).""" .

