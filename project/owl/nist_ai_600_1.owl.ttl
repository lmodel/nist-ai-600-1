    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Data retention." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#DECOMMISSIONING> a owl:Class ;
    rdfs:label "DECOMMISSIONING" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Decommissioning practices." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#DISCOURAGING_ANONYMOUS_USE> a owl:Class ;
    rdfs:label "DISCOURAGING_ANONYMOUS_USE" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Discouraging anonymous use." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#EDUCATION> a owl:Class ;
    rdfs:label "EDUCATION" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Education on GAI risks and responsible use." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#IMPACT_ASSESSMENTS> a owl:Class ;
    rdfs:label "IMPACT_ASSESSMENTS" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Impact assessments." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#INCIDENT_RESPONSE> a owl:Class ;
    rdfs:label "INCIDENT_RESPONSE" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Incident response procedures." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#MONITORING> a owl:Class ;
    rdfs:label "MONITORING" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Ongoing monitoring of GAI systems." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#OPT_OUTS> a owl:Class ;
    rdfs:label "OPT_OUTS" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "User opt-out mechanisms." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#RISK_BASED_CONTROLS> a owl:Class ;
    rdfs:label "RISK_BASED_CONTROLS" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Risk-based controls." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#RISK_MAPPING_AND_MEASUREMENT> a owl:Class ;
    rdfs:label "RISK_MAPPING_AND_MEASUREMENT" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Risk mapping and measurement." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#SCIENCE_BACKED_TEVV_PRACTICES> a owl:Class ;
    rdfs:label "SCIENCE_BACKED_TEVV_PRACTICES" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Science-backed test, evaluation, validation, and verification practices." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#SECURE_SOFTWARE_DEVELOPMENT_PRACTICES> a owl:Class ;
    rdfs:label "SECURE_SOFTWARE_DEVELOPMENT_PRACTICES" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Secure software development practices." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#STAKEHOLDER_ENGAGEMENT> a owl:Class ;
    rdfs:label "STAKEHOLDER_ENGAGEMENT" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Stakeholder engagement." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#SYNTHETIC_CONTENT_DETECTION_AND_LABELING> a owl:Class ;
    rdfs:label "SYNTHETIC_CONTENT_DETECTION_AND_LABELING" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Synthetic content detection and labeling tools and techniques." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#WHISTLEBLOWER_PROTECTIONS> a owl:Class ;
    rdfs:label "WHISTLEBLOWER_PROTECTIONS" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Whistleblower protections." .

<https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#WORKFORCE_DIVERSITY_AND_INTERDISCIPLINARY_TEAMS> a owl:Class ;
    rdfs:label "WORKFORCE_DIVERSITY_AND_INTERDISCIPLINARY_TEAMS" ;
    rdfs:subClassOf nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition "Workforce diversity and interdisciplinary teams." .

<https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#CONTENT_PROVENANCE> a owl:Class ;
    rdfs:label "CONTENT_PROVENANCE" ;
    rdfs:subClassOf nist_ai_600_1:PrimaryConsiderationEnum ;
    skos:definition """Digital transparency mechanisms (provenance data tracking,
watermarking, synthetic content detection) for tracing
origin and history of content (A.1.6 - A.1.7).""" .

<https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#GOVERNANCE> a owl:Class ;
    rdfs:label "GOVERNANCE" ;
    rdfs:subClassOf nist_ai_600_1:PrimaryConsiderationEnum ;
    skos:definition """How organizational governance regimes may be re-evaluated
and adjusted for GAI contexts (A.1).""" .

<https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#INCIDENT_DISCLOSURE> a owl:Class ;
    rdfs:label "INCIDENT_DISCLOSURE" ;
    rdfs:subClassOf nist_ai_600_1:PrimaryConsiderationEnum ;
    skos:definition """Documenting, reporting, and sharing information about AI
incidents to mitigate harm and improve risk management
(A.1.8).""" .

<https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#PRE_DEPLOYMENT_TESTING> a owl:Class ;
    rdfs:label "PRE_DEPLOYMENT_TESTING" ;
    rdfs:subClassOf nist_ai_600_1:PrimaryConsiderationEnum ;
    skos:definition """Test, evaluation, validation, and verification practices
appropriate for GAI prior to deployment (A.1.4).""" .

<https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#DIGITAL_FINGERPRINTING> a owl:Class ;
    rdfs:label "DIGITAL_FINGERPRINTING" ;
    rdfs:subClassOf nist_ai_600_1:ProvenanceTechniqueEnum ;
    skos:definition """Computing a content-derived identifier that can be matched
against a reference store to detect known content.""" .

<https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#DIGITAL_WATERMARKING> a owl:Class ;
    rdfs:label "DIGITAL_WATERMARKING" ;
    rdfs:subClassOf nist_ai_600_1:ProvenanceTechniqueEnum ;
    skos:definition """Overt or covert digital watermarks embedded in content to
allow downstream verification of origin.""" .

<https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#HUMAN_AUTHENTICATION> a owl:Class ;
    rdfs:label "HUMAN_AUTHENTICATION" ;
    rdfs:subClassOf nist_ai_600_1:ProvenanceTechniqueEnum ;
    skos:definition """Human-mediated verification of content origin or
authenticity.""" .

<https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#METADATA_RECORDING> a owl:Class ;
    rdfs:label "METADATA_RECORDING" ;
    rdfs:subClassOf nist_ai_600_1:ProvenanceTechniqueEnum ;
    skos:definition """Recording metadata about content (creator, date/time,
location, modifications, sources) for text, image, video,
audio, or underlying datasets.""" .

<https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#COMBINATION> a owl:Class ;
    rdfs:label "COMBINATION" ;
    rdfs:subClassOf nist_ai_600_1:RedTeamingTypeEnum ;
    skos:definition """Hybrid exercises using both expert and general-public
participants.""" .

<https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#EXPERT> a owl:Class ;
    rdfs:label "EXPERT" ;
    rdfs:subClassOf nist_ai_600_1:RedTeamingTypeEnum ;
    skos:definition """Performed by specialists with expertise in the domain or
specific red-teaming context (medicine, biotech,
cybersecurity).""" .

<https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#GENERAL_PUBLIC> a owl:Class ;
    rdfs:label "GENERAL_PUBLIC" ;
    rdfs:subClassOf nist_ai_600_1:RedTeamingTypeEnum ;
    skos:definition """Performed by general users not necessarily having AI or
technical expertise.""" .

<https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#HUMAN_AND_AI> a owl:Class ;
    rdfs:label "HUMAN_AND_AI" ;
    rdfs:subClassOf nist_ai_600_1:RedTeamingTypeEnum ;
    skos:definition """Performed by GAI in combination with specialist or
non-specialist human teams.""" .

<https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#AI_RED_TEAMING> a owl:Class ;
    rdfs:label "AI_RED_TEAMING" ;
    rdfs:subClassOf nist_ai_600_1:StructuredFeedbackMethodEnum ;
    skos:definition """A structured testing exercise used to probe an AI system
to find flaws and vulnerabilities such as inaccurate,
harmful, or discriminatory outputs.""" .

<https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#FIELD_TESTING> a owl:Class ;
    rdfs:label "FIELD_TESTING" ;
    rdfs:subClassOf nist_ai_600_1:StructuredFeedbackMethodEnum ;
    skos:definition """Methods used to determine how people interact with,
consume, use, and make sense of AI-generated information
(UX, usability, randomised experiments).""" .

<https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS> a owl:Class ;
    rdfs:label "PARTICIPATORY_ENGAGEMENT_METHODS" ;
    rdfs:subClassOf nist_ai_600_1:StructuredFeedbackMethodEnum ;
    skos:definition """Methods used to solicit feedback from civil society groups,
affected communities, and users (focus groups, small user
studies, surveys).""" .

<https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT> a owl:Class ;
    rdfs:label "ACCOUNTABLE_AND_TRANSPARENT" ;
    rdfs:subClassOf nist_ai_600_1:TrustworthinessCharacteristicEnum ;
    skos:definition """Trustworthy AI depends on accountability, which presupposes
transparency - the extent to which information about an AI
system and its outputs is available to those interacting with
it.""" .

<https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE> a owl:Class ;
    rdfs:label "EXPLAINABLE_AND_INTERPRETABLE" ;
    rdfs:subClassOf nist_ai_600_1:TrustworthinessCharacteristicEnum ;
    skos:definition """Explainability concerns the mechanisms underlying an AI system's
operation; interpretability concerns the meaning of its output
in context.""" .

<https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> a owl:Class ;
    rdfs:label "FAIR_WITH_HARMFUL_BIAS_MANAGED" ;
    rdfs:subClassOf nist_ai_600_1:TrustworthinessCharacteristicEnum ;
    skos:definition """Concerns for equality and equity by addressing issues such as
harmful bias and discrimination, and recognising that
perceptions of fairness differ across cultures and
applications.""" .

<https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED> a owl:Class ;
    rdfs:label "PRIVACY_ENHANCED" ;
    rdfs:subClassOf nist_ai_600_1:TrustworthinessCharacteristicEnum ;
    skos:definition """Norms and practices that help safeguard human autonomy,
identity, and dignity - including anonymity, confidentiality,
and control over personal information.""" .

<https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#SAFE> a owl:Class ;
    rdfs:label "SAFE" ;
    rdfs:subClassOf nist_ai_600_1:TrustworthinessCharacteristicEnum ;
    skos:definition """The system does not, under defined conditions, lead to a state
in which human life, health, property, or the environment is
endangered.""" .

<https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT> a owl:Class ;
    rdfs:label "SECURE_AND_RESILIENT" ;
    rdfs:subClassOf nist_ai_600_1:TrustworthinessCharacteristicEnum ;
    skos:definition """The system can withstand unexpected adverse events or changes
(resilient) and maintain confidentiality, integrity, and
availability through protection mechanisms (secure).""" .

<https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE> a owl:Class ;
    rdfs:label "VALID_AND_RELIABLE" ;
    rdfs:subClassOf nist_ai_600_1:TrustworthinessCharacteristicEnum ;
    skos:definition """Confirmation that requirements for a specific intended use have
been fulfilled (validation) and that the system performs as
required without failure (reliability). A necessary condition of
trustworthiness and the base for other characteristics.""" .

nist_ai_600_1:actor_task a owl:ObjectProperty ;
    rdfs:label "actor_task" ;
    skos:definition """Pertinent AI Actor Task(s) for the suggested action - i.e.,
the "AI Actor Tasks" row at the bottom of each Section 3
table.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch nist_ai_100_1:actor_task .

nist_ai_600_1:addressed_by_actions a owl:ObjectProperty ;
    rdfs:label "addressed_by_actions" ;
    rdfs:range nist_ai_600_1:SuggestedAction ;
    skos:definition """Suggested actions that address a GAI risk (back-reference
derived from `SuggestedAction.gai_risks`).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:gai_risk_catalog a owl:ObjectProperty ;
    rdfs:label "gai_risk_catalog" ;
    rdfs:range nist_ai_600_1:GaiRisk ;
    skos:definition "The catalog of GAI risks (Section 2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:gai_risks a owl:ObjectProperty ;
    rdfs:label "gai_risks" ;
    rdfs:range nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition """GAI risk categories addressed by a suggested action or
considered by a primary consideration.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:governance_practices a owl:ObjectProperty ;
    rdfs:label "governance_practices" ;
    rdfs:range nist_ai_600_1:GovernancePracticeEnum ;
    skos:definition """Governance plans and actions enumerated in NIST AI 600-1
Appendix A.1.2 (Organizational Governance).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:lifecycle_stage a owl:ObjectProperty ;
    rdfs:label "lifecycle_stage" ;
    skos:definition """AI lifecycle stage(s) at which the GAI risk may arise
(NIST AI 600-1 Section 2). Uses the GAI five-stage
lifecycle (`GaiLifecycleStageEnum`).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch nist_ai_100_1:lifecycle_stage .

nist_ai_600_1:primary_considerations a owl:ObjectProperty ;
    rdfs:label "primary_considerations" ;
    rdfs:range nist_ai_600_1:PrimaryGaiConsideration ;
    skos:definition """The primary GAI considerations from Appendix A (Governance,
Pre-Deployment Testing, Content Provenance, Incident
Disclosure). Discriminated by `consideration_kind`.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:provenance_techniques a owl:ObjectProperty ;
    rdfs:label "provenance_techniques" ;
    rdfs:range nist_ai_600_1:ProvenanceTechniqueEnum ;
    skos:definition """For Content Provenance: provenance data tracking techniques
such as digital watermarking, metadata recording, digital
fingerprinting, and human authentication (Appendix A.1.6).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:risk_scope a owl:ObjectProperty ;
    rdfs:label "risk_scope" ;
    rdfs:range nist_ai_600_1:GaiRiskScopeEnum ;
    skos:definition "Scope levels at which the risk may manifest." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:risk_sources a owl:ObjectProperty ;
    rdfs:label "risk_sources" ;
    rdfs:range nist_ai_600_1:GaiRiskSourceEnum ;
    skos:definition "Sources from which the risk may emerge." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:structured_feedback_methods a owl:ObjectProperty ;
    rdfs:label "structured_feedback_methods" ;
    rdfs:range nist_ai_600_1:StructuredPublicFeedback ;
    skos:definition """Structured public feedback methods relevant to the profile
(Appendix A.1.5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:suggested_actions a owl:ObjectProperty ;
    rdfs:label "suggested_actions" ;
    rdfs:range nist_ai_600_1:SuggestedAction ;
    skos:definition "Suggested actions to manage GAI risks (Section 3)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:time_scale a owl:ObjectProperty ;
    rdfs:label "time_scale" ;
    rdfs:range nist_ai_600_1:GaiRiskTimeScaleEnum ;
    skos:definition "Time scales over which the risk may materialise." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_100_1:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable description." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common> .

nist_ai_100_1:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "A unique identifier for an element." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common> .

nist_ai_100_1:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "A short human-readable name." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common> .

nist_ai_100_1:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable title." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common> .

nist_ai_600_1:GaiRisk a owl:Class ;
    rdfs:label "GaiRisk" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:risk_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:risk_categorization ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiRiskCategorizationEnum ;
            owl:onProperty nist_ai_600_1:risk_categorization ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:gai_risk_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiRiskScopeEnum ;
            owl:onProperty nist_ai_600_1:risk_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_100_1:trustworthiness_characteristic ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:TrustworthinessCharacteristicEnum ;
            owl:onProperty nist_ai_100_1:trustworthiness_characteristic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:gai_risk_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiLifecycleStageEnum ;
            owl:onProperty nist_ai_600_1:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiRiskTimeScaleEnum ;
            owl:onProperty nist_ai_600_1:time_scale ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiRiskSourceEnum ;
            owl:onProperty nist_ai_600_1:risk_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:SuggestedAction ;
            owl:onProperty nist_ai_600_1:addressed_by_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:time_scale ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiRiskCategoryEnum ;
            owl:onProperty nist_ai_600_1:gai_risk_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:addressed_by_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:risk_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:risk_categorization ],
        nist_ai_100_1:NamedThing ;
    skos:broadMatch iso27001:Risk ;
    skos:closeMatch nist_ai_100_1:AiSpecificRisk ;
    skos:definition """A risk that is novel to or exacerbated by Generative AI.
Each instance corresponds to one of the 12 risk categories
enumerated in NIST AI 600-1 Section 2.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch iso29100:PrivacyRisk .

nist_ai_600_1:PrimaryGaiConsideration a owl:Class ;
    rdfs:label "PrimaryGaiConsideration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:ai_incident_definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:consideration_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:ProvenanceTechniqueEnum ;
            owl:onProperty nist_ai_600_1:provenance_techniques ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:limitations_of_current_approaches ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:third_party_considerations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:third_party_considerations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:governance_practices ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:provenance_techniques ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:third_party_considerations ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:PrimaryConsiderationEnum ;
            owl:onProperty nist_ai_600_1:consideration_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_600_1:consideration_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:ai_incident_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:ai_incident_definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:limitations_of_current_approaches ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GovernancePracticeEnum ;
            owl:onProperty nist_ai_600_1:governance_practices ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:limitations_of_current_approaches ],
        nist_ai_100_1:NamedThing ;
    skos:definition """An overarching consideration derived from the NIST GAI PWG
consultation process (Appendix A). The `consideration_kind`
attribute discriminates between the four primary
considerations: Governance, Pre-Deployment Testing, Content
Provenance, and Incident Disclosure.

All consideration-specific attributes are optional and apply
to the appropriate `consideration_kind`:
  * GOVERNANCE: governance_practices, third_party_considerations
  * PRE_DEPLOYMENT_TESTING: limitations_of_current_approaches
  * CONTENT_PROVENANCE: provenance_techniques
  * INCIDENT_DISCLOSURE: ai_incident_definition""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch nist_csf:CSFProperty .

nist_ai_600_1:action_id a owl:DatatypeProperty ;
    rdfs:label "action_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of a Suggested Action." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:ai_incident_definition a owl:DatatypeProperty ;
    rdfs:label "ai_incident_definition" ;
    rdfs:range xsd:string ;
    skos:definition """For Incident Disclosure: the definition of AI incident used
by the organisation (Appendix A.1.8).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:applies_to_subcategory a owl:DatatypeProperty ;
    rdfs:label "applies_to_subcategory" ;
    rdfs:range xsd:string ;
    skos:closeMatch oscal_profile:Profile ;
    skos:definition "Identifier of the AI RMF subcategory the action applies to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:consideration_kind a owl:ObjectProperty ;
    rdfs:label "consideration_kind" ;
    rdfs:range nist_ai_600_1:PrimaryConsiderationEnum ;
    skos:definition "Which primary consideration this element represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:function_prefix a owl:ObjectProperty ;
    rdfs:label "function_prefix" ;
    rdfs:range nist_ai_600_1:GaiActionFunctionPrefixEnum ;
    skos:definition "Two-letter function prefix of the action's subcategory." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:gai_risk_kind a owl:ObjectProperty ;
    rdfs:label "gai_risk_kind" ;
    rdfs:range nist_ai_600_1:GaiRiskCategoryEnum ;
    skos:definition "The GAI risk category this element represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:limitations_of_current_approaches a owl:DatatypeProperty ;
    rdfs:label "limitations_of_current_approaches" ;
    rdfs:range xsd:string ;
    skos:definition """For Pre-Deployment Testing: free-text discussion of why
current TEVV approaches may be inadequate (Appendix A.1.4).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:red_team_type a owl:ObjectProperty ;
    rdfs:label "red_team_type" ;
    rdfs:range nist_ai_600_1:RedTeamingTypeEnum ;
    skos:definition "The type of AI red-teaming exercise." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:risk_categorization a owl:ObjectProperty ;
    rdfs:label "risk_categorization" ;
    rdfs:range nist_ai_600_1:GaiRiskCategorizationEnum ;
    skos:definition """Higher-level categorisation - technical/model, misuse, or
ecosystem/societal.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:third_party_considerations a owl:DatatypeProperty ;
    rdfs:label "third_party_considerations" ;
    rdfs:range xsd:string ;
    skos:definition """Considerations for third-party GAI integrations, procurement,
SBOMs, SLAs, and SSAE reports (Appendix A.1.3).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:GaiRiskTimeScaleEnum a owl:Class ;
    rdfs:label "GaiRiskTimeScaleEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#IMMEDIATE> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#PROLONGED> ) ;
    skos:definition """The time scale over which a GAI risk may materialise
(Section 2).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#IMMEDIATE>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#PROLONGED> .

nist_ai_600_1:StructuredPublicFeedback a owl:Class ;
    rdfs:label "StructuredPublicFeedback" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:StructuredFeedbackMethodEnum ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        nist_ai_100_1:NamedThing ;
    skos:definition """Methods used to evaluate whether GAI systems are performing as
intended and to calibrate and verify traditional measurement
methods (A.1.5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch iso27001:InterestedParty .

nist_ai_100_1:NamedThing a owl:Class ;
    rdfs:label "NamedThing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_100_1:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_100_1:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_100_1:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_100_1:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_100_1:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_100_1:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_100_1:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_100_1:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_100_1:see_also ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty nist_ai_100_1:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_100_1:title ],
        [ owl:unionOf ( nist_ai_600_1:GaiProfile nist_ai_600_1:GaiRisk nist_ai_600_1:PrimaryGaiConsideration nist_ai_600_1:StructuredPublicFeedback nist_ai_600_1:SuggestedAction ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_100_1:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_100_1:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty nist_ai_100_1:see_also ] ;
    skos:closeMatch schema1:Thing ;
    skos:definition "A generic grouping for any identifiable AI RMF element." ;
    skos:exactMatch schema1:Thing ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1/schema/nist_ai_rmf_common> .

nist_ai_600_1:GaiRiskCategorizationEnum a owl:Class ;
    rdfs:label "GaiRiskCategorizationEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#TECHNICAL_OR_MODEL_RISKS> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#MISUSE_BY_HUMANS> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#ECOSYSTEM_OR_SOCIETAL_RISKS> ) ;
    skos:definition """Higher-level grouping of GAI risks, derived from the UK's
International Scientific Report on the Safety of Advanced AI
(NIST AI 600-1 Section 2, footnote 5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#ECOSYSTEM_OR_SOCIETAL_RISKS>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#MISUSE_BY_HUMANS>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#TECHNICAL_OR_MODEL_RISKS> .

nist_ai_600_1:GaiRiskScopeEnum a owl:Class ;
    rdfs:label "GaiRiskScopeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#MODEL_OR_SYSTEM> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#APPLICATION_OR_IMPLEMENTATION> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#ECOSYSTEM> ) ;
    skos:definition "The scope at which a GAI risk may manifest (Section 2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#APPLICATION_OR_IMPLEMENTATION>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#ECOSYSTEM>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#MODEL_OR_SYSTEM> .

nist_ai_600_1:StructuredFeedbackMethodEnum a owl:Class ;
    rdfs:label "StructuredFeedbackMethodEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS> <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#FIELD_TESTING> <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#AI_RED_TEAMING> ) ;
    skos:definition """Categories of structured public feedback for GAI risk
management (Appendix A.1.5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#AI_RED_TEAMING>,
        <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#FIELD_TESTING>,
        <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS> .

nist_ai_600_1:SuggestedAction a owl:Class ;
    rdfs:label "SuggestedAction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_600_1:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiActorTaskEnum ;
            owl:onProperty nist_ai_600_1:actor_task ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:function_prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:applies_to_subcategory ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:actor_task ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:applies_to_subcategory ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:function_prefix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:action_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiRiskCategoryEnum ;
            owl:onProperty nist_ai_600_1:gai_risks ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_600_1:action_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiActionFunctionPrefixEnum ;
            owl:onProperty nist_ai_600_1:function_prefix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:action_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:applies_to_subcategory ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:gai_risks ],
        nist_ai_100_1:NamedThing ;
    skos:closeMatch stix:CourseOfAction ;
    skos:definition """A suggested action an organisation can take to manage GAI
risks. Each action is identified by an Action ID, linked to an
AI RMF subcategory, and may be relevant to one or more GAI
risks and AI actor tasks (NIST AI 600-1 Section 3).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch gist_linkml:Task,
        oscal_catalog:Control .

nist_ai_600_1:GaiActionFunctionPrefixEnum a owl:Class ;
    rdfs:label "GaiActionFunctionPrefixEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#GV> <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MP> <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MS> <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MG> ) ;
    skos:definition "Two-letter function prefix used in GAI Action IDs." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#GV>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MG>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MP>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MS> .

nist_ai_600_1:GaiLifecycleStageEnum a owl:Class ;
    rdfs:label "GaiLifecycleStageEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DESIGN> <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEVELOPMENT> <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEPLOYMENT> <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#OPERATION> <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DECOMMISSIONING> ) ;
    skos:definition """AI lifecycle stages enumerated in NIST AI 600-1 Section 2:
"Risks can arise during design, development, deployment,
operation, and/or decommissioning." Distinct from the six-stage
`AiLifecycleStageEnum` of NIST AI 100-1 (see `related_mappings`).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch nist_ai_100_1:AiLifecycleStageEnum ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DECOMMISSIONING>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEPLOYMENT>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DESIGN>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEVELOPMENT>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#OPERATION> .

nist_ai_600_1:PrimaryConsiderationEnum a owl:Class ;
    rdfs:label "PrimaryConsiderationEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#GOVERNANCE> <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#PRE_DEPLOYMENT_TESTING> <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#CONTENT_PROVENANCE> <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#INCIDENT_DISCLOSURE> ) ;
    skos:definition """The four overarching themes derived from the GAI PWG
consultation process (Appendix A).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#CONTENT_PROVENANCE>,
        <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#GOVERNANCE>,
        <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#INCIDENT_DISCLOSURE>,
        <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#PRE_DEPLOYMENT_TESTING> .

nist_ai_600_1:ProvenanceTechniqueEnum a owl:Class ;
    rdfs:label "ProvenanceTechniqueEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#DIGITAL_WATERMARKING> <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#METADATA_RECORDING> <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#DIGITAL_FINGERPRINTING> <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#HUMAN_AUTHENTICATION> ) ;
    skos:definition """Provenance data tracking techniques for GAI content
(Appendix A.1.6). "Some well-known techniques for provenance
data tracking include digital watermarking, metadata
recording, digital fingerprinting, and human authentication,
among others.\"""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#DIGITAL_FINGERPRINTING>,
        <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#DIGITAL_WATERMARKING>,
        <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#HUMAN_AUTHENTICATION>,
        <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#METADATA_RECORDING> .

nist_ai_600_1:RedTeamingTypeEnum a owl:Class ;
    rdfs:label "RedTeamingTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#GENERAL_PUBLIC> <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#EXPERT> <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#COMBINATION> <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#HUMAN_AND_AI> ) ;
    skos:definition "Types of AI red-teaming exercises (Appendix A.1.5)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#COMBINATION>,
        <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#EXPERT>,
        <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#GENERAL_PUBLIC>,
        <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#HUMAN_AND_AI> .

nist_ai_600_1:feedback_method_kind a owl:ObjectProperty ;
    rdfs:label "feedback_method_kind" ;
    rdfs:range nist_ai_600_1:StructuredFeedbackMethodEnum ;
    skos:definition "Which structured feedback method this element represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:GaiRiskSourceEnum a owl:Class ;
    rdfs:label "GaiRiskSourceEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#DESIGN> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#TRAINING> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#OPERATION> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_INPUTS> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_OUTPUTS> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#HUMAN_BEHAVIOR> <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#HUMAN_AI_INTERACTION> ) ;
    skos:definition "The source(s) from which a GAI risk may emerge (Section 2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
