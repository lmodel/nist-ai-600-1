        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_OUTPUTS>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#OPERATION>,
        <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#TRAINING> .

nist_ai_600_1:TrustworthinessCharacteristicEnum a owl:Class ;
    rdfs:label "TrustworthinessCharacteristicEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE> <https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#SAFE> <https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT> <https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT> <https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE> <https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED> <https://w3id.org/lmodel/nist-ai-600-1/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ) ;
