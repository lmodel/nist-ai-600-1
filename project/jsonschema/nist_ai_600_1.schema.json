{
    "$defs": {
        "AiRmfActorTaskName": {
            "description": "The ten AI actor tasks and five additional AI actors of Appendix A.",
            "enum": [
                "ai_design",
                "ai_development",
                "ai_deployment",
                "operation_and_monitoring",
                "tevv",
                "human_factors",
                "domain_expert",
                "ai_impact_assessment",
                "procurement",
                "governance_and_oversight",
                "third_party_entities",
                "end_users",
                "affected_individuals_and_communities",
                "other_ai_actors",
                "general_public"
            ],
            "title": "AiRmfActorTaskName",
            "type": "string"
        },
        "AiRmfCharacteristicName": {
            "description": "The seven characteristics of trustworthy AI systems in section 3 of the publication.",
            "enum": [
                "valid_and_reliable",
                "safe",
                "secure_and_resilient",
                "accountable_and_transparent",
                "explainable_and_interpretable",
                "privacy_enhanced",
                "fair_with_harmful_bias_managed"
            ],
            "title": "AiRmfCharacteristicName",
            "type": "string"
        },
        "AiRmfProfile": {
            "additionalProperties": false,
            "description": "An implementation of the Core's functions, categories and subcategories for a setting, application or technology, based on the adopter's requirements, risk tolerance and resources.",
            "properties": {
                "ai_rmf_id": {
                    "description": "The identifier an adopter gives a record of its own.",
                    "type": "string"
                },
                "ai_rmf_profile_kinds": {
                    "description": "Which of the publication's kinds of profile this is. A current profile for one use case is both.",
                    "items": {
                        "$ref": "#/$defs/AiRmfProfileKind"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "ai_rmf_profile_setting": {
                    "description": "The sector, industry, technology, organization or end use the profile covers, such as hiring.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "ai_rmf_profile_subcategories": {
                    "description": "The subcategories the profile selects. An adopter may select from them rather than apply all.",
                    "items": {
                        "pattern": "^(GOVERN [1-6]|MAP [1-5]|MEASURE [1-4]|MANAGE [1-4])\\.[1-9][0-9]?$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "description": "The element's name.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "ai_rmf_profile_kinds",
                "ai_rmf_id"
            ],
            "title": "AiRmfProfile",
            "type": "object"
        },
        "AiRmfProfileKind": {
            "description": "The kinds of AI RMF profile that section 6 names.",
            "enum": [
                "use_case",
                "current",
                "target",
                "cross_sectoral"
            ],
            "title": "AiRmfProfileKind",
            "type": "string"
        },
        "AiRmfRecord": {
            "additionalProperties": false,
            "description": "The base of the classes that record an adopter's own facts, such as one of its AI systems or risks, as distinct from what the publication itself lists.",
            "properties": {
                "ai_rmf_id": {
                    "description": "The identifier an adopter gives a record of its own.",
                    "type": "string"
                },
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "description": "The element's name.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "ai_rmf_id"
            ],
            "title": "AiRmfRecord",
            "type": "object"
        },
        "GaiAiRedTeaming": {
            "additionalProperties": false,
            "description": "A structured exercise that probes an AI system for flaws and vulnerabilities, often with its developers.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_feedback_type": {
                    "description": "Which of the three classes this record is.",
                    "enum": [
                        "GaiAiRedTeaming"
                    ],
                    "type": "string"
                },
                "gai_red_teaming_types": {
                    "description": "The kinds of AI red-teaming that may suit the use case.",
                    "items": {
                        "$ref": "#/$defs/GaiRedTeamingType"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_feedback_type",
                "title"
            ],
            "title": "GaiAiRedTeaming",
            "type": "object"
        },
        "GaiContentProvenanceConsideration": {
            "additionalProperties": false,
            "description": "How tracking the origin and history of content helps tell authentic content from synthetic content.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_consideration_sections": {
                    "description": "The subsections of Appendix A that discuss the consideration, such as A.1.2.",
                    "items": {
                        "pattern": "^A\\.1(\\.[1-8])?$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_consideration_type": {
                    "description": "Which of the four classes this record is.",
                    "enum": [
                        "GaiContentProvenanceConsideration"
                    ],
                    "type": "string"
                },
                "gai_provenance_techniques": {
                    "description": "The well-known techniques for provenance data tracking that section A.1.6 names.",
                    "items": {
                        "$ref": "#/$defs/GaiProvenanceTechnique"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_consideration_type",
                "title"
            ],
            "title": "GaiContentProvenanceConsideration",
            "type": "object"
        },
        "GaiFieldTesting": {
            "additionalProperties": false,
            "description": "Structured settings that show how people interact with and use AI-generated information.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_feedback_type": {
                    "description": "Which of the three classes this record is.",
                    "enum": [
                        "GaiFieldTesting"
                    ],
                    "type": "string"
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_feedback_type",
                "title"
            ],
            "title": "GaiFieldTesting",
            "type": "object"
        },
        "GaiGovernanceConsideration": {
            "additionalProperties": false,
            "description": "How an organization's governance can be revisited for GAI, including across the AI value chain.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_consideration_sections": {
                    "description": "The subsections of Appendix A that discuss the consideration, such as A.1.2.",
                    "items": {
                        "pattern": "^A\\.1(\\.[1-8])?$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_consideration_type": {
                    "description": "Which of the four classes this record is.",
                    "enum": [
                        "GaiGovernanceConsideration"
                    ],
                    "type": "string"
                },
                "gai_governance_plans": {
                    "description": "The plans and actions that section A.1.2 lists from other AI governance.",
                    "items": {
                        "$ref": "#/$defs/GaiGovernancePlan"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_third_party_controls": {
                    "description": "The existing controls that section A.1.3 says can apply to third-party GAI.",
                    "items": {
                        "$ref": "#/$defs/GaiThirdPartyControl"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_consideration_type",
                "title"
            ],
            "title": "GaiGovernanceConsideration",
            "type": "object"
        },
        "GaiGovernancePlan": {
            "description": "The plans and actions that section A.1.2 says apply to GAI from other AI governance.",
            "enum": [
                "accessibility_and_reasonable_accommodations",
                "ai_actor_credentials_and_qualifications",
                "alignment_to_organizational_values",
                "auditing_and_assessment",
                "change_management_controls",
                "commercial_use",
                "data_provenance",
                "data_protection",
                "data_retention",
                "consistency_in_use_of_defining_key_terms",
                "decommissioning",
                "discouraging_anonymous_use",
                "education",
                "impact_assessments",
                "incident_response",
                "monitoring",
                "opt_outs",
                "risk_based_controls",
                "risk_mapping_and_measurement",
                "science_backed_tevv_practices",
                "secure_software_development_practices",
                "stakeholder_engagement",
                "synthetic_content_detection_and_labeling_tools_and_techniques",
                "whistleblower_protections",
                "workforce_diversity_and_interdisciplinary_teams"
            ],
            "title": "GaiGovernancePlan",
            "type": "string"
        },
        "GaiIncidentDisclosureConsideration": {
            "additionalProperties": false,
            "description": "How documenting, reporting and sharing AI incidents helps prevent harm, though no formal channels exist.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_consideration_sections": {
                    "description": "The subsections of Appendix A that discuss the consideration, such as A.1.2.",
                    "items": {
                        "pattern": "^A\\.1(\\.[1-8])?$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_consideration_type": {
                    "description": "Which of the four classes this record is.",
                    "enum": [
                        "GaiIncidentDisclosureConsideration"
                    ],
                    "type": "string"
                },
                "gai_incident_harms": {
                    "description": "The kinds of harm that section A.1.8's definition of an AI incident names.",
                    "items": {
                        "$ref": "#/$defs/GaiIncidentHarm"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_consideration_type",
                "title"
            ],
            "title": "GaiIncidentDisclosureConsideration",
            "type": "object"
        },
        "GaiIncidentHarm": {
            "description": "The kinds of harm that section A.1.8's definition of an AI incident names.",
            "enum": [
                "injury_or_harm_to_health",
                "critical_infrastructure_disruption",
                "rights_violations",
                "harm_to_property_communities_or_environment"
            ],
            "title": "GaiIncidentHarm",
            "type": "string"
        },
        "GaiLifecycleStage": {
            "description": "The lifecycle stages section 2 names for GAI. They differ from the seven stages of the AI RMF's Figure 3.",
            "enum": [
                "design",
                "development",
                "deployment",
                "operation",
                "decommissioning"
            ],
            "title": "GaiLifecycleStage",
            "type": "string"
        },
        "GaiParticipatoryEngagement": {
            "additionalProperties": false,
            "description": "Asking civil society groups, affected communities and users for feedback, such as through focus groups or surveys.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_feedback_type": {
                    "description": "Which of the three classes this record is.",
                    "enum": [
                        "GaiParticipatoryEngagement"
                    ],
                    "type": "string"
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_feedback_type",
                "title"
            ],
            "title": "GaiParticipatoryEngagement",
            "type": "object"
        },
        "GaiPreDeploymentTestingConsideration": {
            "additionalProperties": false,
            "description": "How GAI can be tested before deployment while better approaches mature, and where current tests fall short.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_consideration_sections": {
                    "description": "The subsections of Appendix A that discuss the consideration, such as A.1.2.",
                    "items": {
                        "pattern": "^A\\.1(\\.[1-8])?$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_consideration_type": {
                    "description": "Which of the four classes this record is.",
                    "enum": [
                        "GaiPreDeploymentTestingConsideration"
                    ],
                    "type": "string"
                },
                "gai_structured_feedback": {
                    "description": "The kinds of structured public feedback section A.1.5 gives as examples.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/GaiParticipatoryEngagement"
                            },
                            {
                                "$ref": "#/$defs/GaiFieldTesting"
                            },
                            {
                                "$ref": "#/$defs/GaiAiRedTeaming"
                            }
                        ]
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_consideration_type",
                "title"
            ],
            "title": "GaiPreDeploymentTestingConsideration",
            "type": "object"
        },
        "GaiPrimaryConsideration": {
            "additionalProperties": false,
            "description": "One of the four primary considerations of Appendix A, which also inform the suggested actions.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_consideration_sections": {
                    "description": "The subsections of Appendix A that discuss the consideration, such as A.1.2.",
                    "items": {
                        "pattern": "^A\\.1(\\.[1-8])?$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_consideration_type": {
                    "description": "Which of the four classes this record is.",
                    "enum": [
                        "GaiPrimaryConsideration"
                    ],
                    "type": "string"
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_consideration_type",
                "title"
            ],
            "title": "GaiPrimaryConsideration",
            "type": "object"
        },
        "GaiProfile": {
            "additionalProperties": false,
            "description": "The Generative AI Profile as a whole, a cross-sectoral profile of the AI RMF and a companion resource to it.",
            "properties": {
                "ai_rmf_id": {
                    "description": "The identifier an adopter gives a record of its own.",
                    "type": "string"
                },
                "ai_rmf_profile_kinds": {
                    "description": "Which of the publication's kinds of profile this is. A current profile for one use case is both.",
                    "items": {
                        "$ref": "#/$defs/AiRmfProfileKind"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "ai_rmf_profile_setting": {
                    "description": "The sector, industry, technology, organization or end use the profile covers, such as hiring.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "ai_rmf_profile_subcategories": {
                    "description": "The subcategories the profile selects. An adopter may select from them rather than apply all.",
                    "items": {
                        "pattern": "^(GOVERN [1-6]|MAP [1-5]|MEASURE [1-4]|MANAGE [1-4])\\.[1-9][0-9]?$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_primary_considerations": {
                    "description": "The four primary considerations of Appendix A.",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/GaiGovernanceConsideration"
                            },
                            {
                                "$ref": "#/$defs/GaiPreDeploymentTestingConsideration"
                            },
                            {
                                "$ref": "#/$defs/GaiContentProvenanceConsideration"
                            },
                            {
                                "$ref": "#/$defs/GaiIncidentDisclosureConsideration"
                            }
                        ]
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_risks": {
                    "description": "The 12 risks of section 2.",
                    "items": {
                        "$ref": "#/$defs/GaiRisk"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "gai_subcategories": {
                    "description": "The tables of section 3, in the publication's order.",
                    "items": {
                        "$ref": "#/$defs/GaiSubcategory"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "title": {
                    "description": "The element's name.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "gai_risks",
                "gai_subcategories",
                "ai_rmf_profile_kinds",
                "ai_rmf_id"
            ],
            "title": "GaiProfile",
            "type": "object"
        },
        "GaiProvenanceTechnique": {
            "description": "The techniques for provenance data tracking in section A.1.6.",
            "enum": [
                "digital_watermarking",
                "metadata_recording",
                "digital_fingerprinting",
                "human_authentication"
            ],
            "title": "GaiProvenanceTechnique",
            "type": "string"
        },
        "GaiRedTeamingType": {
            "description": "The types of AI red-teaming in section A.1.5.",
            "enum": [
                "general_public",
                "expert",
                "combination",
                "human_ai"
            ],
            "title": "GaiRedTeamingType",
            "type": "string"
        },
        "GaiRisk": {
            "additionalProperties": false,
            "description": "A risk that section 2 defines as unique to or made worse by the development and use of GAI.",
            "properties": {
                "description": {
                    "description": "The risk's definition in section 2.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_risk_characteristics": {
                    "description": "The AI RMF's trustworthiness characteristics that the subsection names for the risk.",
                    "items": {
                        "$ref": "#/$defs/AiRmfCharacteristicName"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_risk_groupings": {
                    "description": "The groups footnote 5 suggests for the risk. The footnote lists Data Privacy under all three.",
                    "items": {
                        "$ref": "#/$defs/GaiRiskGrouping"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_risk_lifecycle_stages": {
                    "description": "The lifecycle stages where the risk can arise for the adopter's model, system or use case.",
                    "items": {
                        "$ref": "#/$defs/GaiLifecycleStage"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_risk_name": {
                    "$ref": "#/$defs/GaiRiskName",
                    "description": "Which of the 12 risks this is."
                },
                "gai_risk_scopes": {
                    "description": "The levels where the risk exists for the adopter's model, system or use case.",
                    "items": {
                        "$ref": "#/$defs/GaiRiskScope"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_risk_section": {
                    "description": "The subsection of section 2 that discusses the risk, such as 2.1.",
                    "pattern": "^2\\.([1-9]|1[0-2])$",
                    "type": "string"
                },
                "gai_risk_sources": {
                    "description": "Where the risk comes from for the adopter's model, system or use case.",
                    "items": {
                        "$ref": "#/$defs/GaiRiskSource"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "gai_risk_time_scales": {
                    "description": "How the risk materializes over time for the adopter's model, system or use case.",
                    "items": {
                        "$ref": "#/$defs/GaiRiskTimeScale"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "gai_risk_name",
                "gai_risk_section"
            ],
            "title": "GaiRisk",
            "type": "object"
        },
        "GaiRiskGrouping": {
            "description": "The three groups into which footnote 5 says an organization could sort the risks, as one possible way.",
            "enum": [
                "technical_or_model",
                "misuse_by_humans",
                "ecosystem_or_societal"
            ],
            "title": "GaiRiskGrouping",
            "type": "string"
        },
        "GaiRiskName": {
            "description": "The 12 risks of section 2.",
            "enum": [
                "cbrn_information_or_capabilities",
                "confabulation",
                "dangerous_violent_or_hateful_content",
                "data_privacy",
                "environmental_impacts",
                "harmful_bias_or_homogenization",
                "human_ai_configuration",
                "information_integrity",
                "information_security",
                "intellectual_property",
                "obscene_degrading_or_abusive_content",
                "value_chain_and_component_integration"
            ],
            "title": "GaiRiskName",
            "type": "string"
        },
        "GaiRiskScope": {
            "description": "The levels where section 2 says a risk may exist.",
            "enum": [
                "model_or_system",
                "application_or_implementation",
                "ecosystem"
            ],
            "title": "GaiRiskScope",
            "type": "string"
        },
        "GaiRiskSource": {
            "description": "Where section 2 says a risk may come from.",
            "enum": [
                "design",
                "training",
                "operation",
                "inputs",
                "outputs",
                "human_behavior",
                "human_ai_interaction"
            ],
            "title": "GaiRiskSource",
            "type": "string"
        },
        "GaiRiskTimeScale": {
            "description": "How section 2 says a risk may materialize over time.",
            "enum": [
                "abrupt",
                "extended"
            ],
            "title": "GaiRiskTimeScale",
            "type": "string"
        },
        "GaiStructuredFeedback": {
            "additionalProperties": false,
            "description": "A way of using structured public feedback to evaluate whether GAI systems perform as intended.",
            "properties": {
                "description": {
                    "description": "What the element says or is.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "gai_feedback_type": {
                    "description": "Which of the three classes this record is.",
                    "enum": [
                        "GaiStructuredFeedback"
                    ],
                    "type": "string"
                },
                "title": {
                    "description": "The element's name.",
                    "type": "string"
                }
            },
            "required": [
                "gai_feedback_type",
                "title"
            ],
            "title": "GaiStructuredFeedback",
            "type": "object"
        },
        "GaiSubcategory": {
            "additionalProperties": false,
            "description": "An AI RMF subcategory as one table of section 3 addresses it. The Profile covers only some of the 72.",
            "properties": {
                "ai_rmf_subcategory_id": {
                    "description": "The subcategory's identifier, such as GOVERN 1.1.",
                    "pattern": "^(GOVERN [1-6]|MAP [1-5]|MEASURE [1-4]|MANAGE [1-4])\\.[1-9][0-9]?$",
